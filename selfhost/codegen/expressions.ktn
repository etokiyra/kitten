// expressions.ktn - render Kitten expressions as C expressions.
//
// It reproduces the expression emitter of the reference generator
// (codegen/emit.go): integer, floating-point, and boolean literals, string
// literals, identifiers, unary expressions, binary expressions, function calls,
// member access and qualified variant references, struct and variant literals,
// array and map creation, indexing, and assignment. It mirrors the reference
// exactly, including the parentheses the reference adds around every unary and
// binary operation, so that its output is byte for byte the reference's for the
// same expression.
//
// An expression is a fragment, not a line: it is built as a string that a caller
// places inside a declaration or a larger expression. It therefore does not go
// through the line-oriented output accumulator, which would force a fragment into
// a line.
//
// The emitter reads the checker's semantic model only where the reference does:
// the left operand's type decides whether "+", "==", and "!=" are string
// operations, and nothing else is looked up. An identifier needs no lookup
// because the checker rejects a name that is not a local variable or parameter in
// expression position, so the reference mangles every identifier as a variable
// and so does this emitter.

import "../checker/model.ktn";
import "../checker/state.ktn";
import "../lexer/tokens.ktn";
import "../parser/ast.ktn";
import "errors.ktn";
import "literals.ktn";
import "names.ktn";

// ExpressionContext is the module an expression belongs to, and the literal pool
// its string literals are interned in. The index selects the module's annotations
// in the semantic model; the module's id, which the model carries, is what names
// are mangled by.
//
// The pool is part of the context rather than a return value because a literal is
// interned where it is rendered, which is what gives the pool the reference's
// first-use order.
public struct ExpressionContext {
    SemanticModel model;
    int module_index;
    LiteralPool pool;
}

// ExpressionResult is a rendered C expression or the reason none was produced.
public union ExpressionResult {
    Ok { string text; }
    Failed { GenerateError error; }
}

// expression_ok reports whether an expression was rendered.
public fn expression_ok(ExpressionResult result) -> bool {
    match (result) {
        Ok(text) { return true; }
        Failed(error) { return false; }
    }
}

// expression_text returns the text of a successful result. Its failure branch
// returns the empty string; no caller can observe it, because the result is
// tested first.
public fn expression_text(ExpressionResult result) -> string {
    match (result) {
        Ok(text) { return text; }
        Failed(error) { return ""; }
    }
}

// expression_error returns the failure a result carries, or an empty error when
// it succeeded.
public fn expression_error(ExpressionResult result) -> GenerateError {
    match (result) {
        Ok(text) { return generate_error(0, 0, ""); }
        Failed(error) { return error; }
    }
}

// expression_kind_name is the name of an expression kind, used in a diagnostic
// and by the driver that reports which expression a rendering belongs to. The
// names follow the shape names used elsewhere in the repository.
public fn expression_kind_name(Expr expression) -> string {
    match (expression) {
        Integer(node_id, token) { return "int"; }
        Float(node_id, token) { return "float"; }
        Boolean(node_id, token, value) { return "bool"; }
        String(node_id, token) { return "string"; }
        Identifier(node_id, token) { return "ident"; }
        Unary(node_id, operator, operand, postfix) { return "unary"; }
        Binary(node_id, operator, left, right) { return "binary"; }
        Assign(node_id, operator, target, value) { return "assign"; }
        Call(node_id, open_paren, callee, arguments, argument_count) { return "call"; }
        Member(node_id, dot, receiver, member) { return "member"; }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { return "struct-literal"; }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { return "variant-literal"; }
        NewArray(node_id, at, element, length) { return "new-array"; }
        NewMap(node_id, at, map_type) { return "new-map"; }
        Index(node_id, bracket, target, index) { return "index"; }
    }
}

// emit_expression renders one expression as a C expression.
//
// Every kind is rendered. A string literal is pooled rather than emitted as a C
// string of its own: its bytes are escaped once, an equal literal shares the
// object, and the reference is the object's address.
public fn emit_expression(ExpressionContext context, Expr expression) -> ExpressionResult {
    match (expression) {
        Integer(node_id, token) {
            // An integer literal is its source spelling: the language defines no
            // form that C would spell differently.
            return ExpressionResult.Ok { text = token.text };
        }
        Float(node_id, token) {
            // A floating-point literal is its source spelling too. The reference
            // never reformats it, so the generated C holds exactly the digits the
            // source wrote, and no rounding or exponent notation is introduced.
            return ExpressionResult.Ok { text = token.text };
        }
        Boolean(node_id, token, value) {
            if (value) {
                return ExpressionResult.Ok { text = "true" };
            }
            return ExpressionResult.Ok { text = "false" };
        }
        Identifier(node_id, token) {
            return ExpressionResult.Ok { text = variable_name(token.text) };
        }
        Unary(node_id, operator, operand, postfix) {
            return unary_expression(context, operator, operand, postfix);
        }
        Binary(node_id, operator, left, right) {
            return binary_expression(context, operator, left, right);
        }
        String(node_id, token) {
            return string_literal(context, token);
        }
        Assign(node_id, operator, target, value) {
            return assign_expression(context, operator, target, value);
        }
        Call(node_id, open_paren, callee, arguments, argument_count) {
            return call_expression(context, node_id, callee, arguments, argument_count);
        }
        Member(node_id, dot, receiver, member) {
            return member_expression(context, node_id, receiver, member);
        }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) {
            return struct_literal_expression(context, type_ref, open_brace, fields, field_count);
        }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) {
            return variant_literal_expression(context, type_ref, variant, open_brace, fields, field_count);
        }
        NewArray(node_id, at, element, length) {
            return new_array_expression(context, at, element, length);
        }
        NewMap(node_id, at, map_type) {
            return new_map_expression(context, at, map_type);
        }
        Index(node_id, bracket, target, index) {
            return index_expression(context, node_id, bracket, target, index);
        }
    }
}

// string_literal interns a string literal in the pool and renders a reference to
// the pooled object, which is how the reference renders one: the literal's bytes
// are escaped once, an equal literal shares the pooled object, and the reference
// is the pooled object's address.
//
// A literal that does not fit in the pool is reported at the literal, which is
// where the reference reports a literal it cannot encode.
fn string_literal(ExpressionContext context, Token token) -> ExpressionResult {
    CStringLiteral literal = c_string_literal(token.text);
    match (literal_symbol(context.pool, literal.escaped, literal.length)) {
        Ok(index) {
            return ExpressionResult.Ok { text = "(&" + literal_name(index) + ")" };
        }
        Failed(error) {
            Position at = position_of_token(token);
            return ExpressionResult.Failed {
                error = generate_error(at.line, at.column, error.message)
            };
        }
    }
}

// --- Assignment --------------------------------------------------------------

// IndexTarget is an index expression's target and index.
struct IndexTarget {
    Expr target;
    Expr index;
}

// IndexTargetParts is an index expression's target and index. Assignment uses it
// to recognize the one target form whose plain assignment is a map insertion,
// without matching every expression kind at the call site.
union IndexTargetParts {
    Absent
    Present { IndexTarget parts; }
}

// index_target_parts returns an index expression's target and index, or Absent
// when the expression is not an index.
fn index_target_parts(Expr expression) -> IndexTargetParts {
    match (expression) {
        Index(node_id, bracket, target, index) {
            return IndexTargetParts.Present {
                parts = IndexTarget { target = target, index = index }
            };
        }
        Integer(node_id, token) { return IndexTargetParts.Absent; }
        Float(node_id, token) { return IndexTargetParts.Absent; }
        Boolean(node_id, token, value) { return IndexTargetParts.Absent; }
        String(node_id, token) { return IndexTargetParts.Absent; }
        Identifier(node_id, token) { return IndexTargetParts.Absent; }
        Unary(node_id, operator, operand, postfix) { return IndexTargetParts.Absent; }
        Binary(node_id, operator, left, right) { return IndexTargetParts.Absent; }
        Assign(node_id, operator, target, value) { return IndexTargetParts.Absent; }
        Call(node_id, open_paren, callee, arguments, argument_count) { return IndexTargetParts.Absent; }
        Member(node_id, dot, receiver, member) { return IndexTargetParts.Absent; }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { return IndexTargetParts.Absent; }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { return IndexTargetParts.Absent; }
        NewArray(node_id, at, element, length) { return IndexTargetParts.Absent; }
        NewMap(node_id, at, map_type) { return IndexTargetParts.Absent; }
    }
}

// MapAssignment is a plain map-entry assignment, or the report that the target is
// not a map index and the ordinary assignment path applies.
union MapAssignment {
    NotMap
    Handled { ExpressionResult result; }
}

// map_entry_assignment renders a plain assignment whose target is a map entry as
// the runtime insertion that creates or updates it. It must not go through the
// reading accessor, which fails when the key is absent.
//
// The map, key, and value are rendered in that order, after the value type and C
// type are read, exactly as the reference orders them. The runtime copies the
// value bytes, so the value is passed by address through a compound literal.
fn map_entry_assignment(ExpressionContext context, Token operator, Expr target, Expr value) -> MapAssignment {
    match (index_target_parts(target)) {
        Absent {
            return MapAssignment.NotMap;
        }
        Present(parts) {
            ModuleModel module = module_model(context.model, context.module_index);
            match (expression_info(module, expr_node_id(parts.target)).type) {
                Absent {
                    return MapAssignment.Handled {
                        result = missing_expression_type(parts.target)
                    };
                }
                Present(map_type) {
                    if (!is_map(map_type)) {
                        return MapAssignment.NotMap;
                    }
                    match (c_type(value_of(map_type))) {
                        Failed(message) {
                            Position at = position_of_token(operator);
                            return MapAssignment.Handled {
                                result = ExpressionResult.Failed {
                                    error = generate_error(at.line, at.column, message)
                                }
                            };
                        }
                        Ok(value_text) {
                            match (emit_expression(context, parts.target)) {
                                Failed(error) {
                                    return MapAssignment.Handled {
                                        result = ExpressionResult.Failed { error = error }
                                    };
                                }
                                Ok(map_text) {
                                    match (emit_expression(context, parts.index)) {
                                        Failed(error) {
                                            return MapAssignment.Handled {
                                                result = ExpressionResult.Failed { error = error }
                                            };
                                        }
                                        Ok(key_text) {
                                            match (emit_expression(context, value)) {
                                                Failed(error) {
                                                    return MapAssignment.Handled {
                                                        result = ExpressionResult.Failed { error = error }
                                                    };
                                                }
                                                Ok(value_expression) {
                                                    return MapAssignment.Handled {
                                                        result = ExpressionResult.Ok {
                                                            text = map_set_function() + "(" + map_text + ", " + key_text + ", &(" + value_text + "){ " + value_expression + " })"
                                                        }
                                                    };
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// assign_expression renders an assignment. Kitten and C agree on "=", "+=", and
// "-=", and both yield the assigned value.
//
// A plain assignment to a map entry inserts or updates it and is handled by the
// map-specific path above. String "+=" has no C equivalent, so it is lowered to a
// runtime append that receives the address of the target slot. Taking the address
// evaluates the target once, so an index target such as "a[i] += value" evaluates
// i once. Every other assignment keeps the reference's parenthesized C shape.
fn assign_expression(ExpressionContext context, Token operator, Expr target, Expr value) -> ExpressionResult {
    if (operator.text == "=") {
        match (map_entry_assignment(context, operator, target, value)) {
            Handled(result) {
                return result;
            }
            NotMap { }
        }
    }

    ExpressionResult rendered_target = emit_expression(context, target);
    if (!expression_ok(rendered_target)) {
        return rendered_target;
    }
    ExpressionResult rendered_value = emit_expression(context, value);
    if (!expression_ok(rendered_value)) {
        return rendered_value;
    }
    string target_text = expression_text(rendered_target);
    string value_text_rendered = expression_text(rendered_value);

    if (operator.text == "+=" || operator.text == "-=") {
        ModuleModel module = module_model(context.model, context.module_index);
        match (expression_info(module, expr_node_id(target)).type) {
            Absent {
                return missing_expression_type(target);
            }
            Present(target_type) {
                if (target_type.kind == TypeKind.String && operator.text == "+=") {
                    return ExpressionResult.Ok {
                        text = string_append_function() + "(&(" + target_text + "), " + value_text_rendered + ")"
                    };
                }
                if (target_type.kind == TypeKind.Int) {
                    string helper = i64_add_assign_function();
                    if (operator.text == "-=") {
                        helper = i64_sub_assign_function();
                    }
                    return ExpressionResult.Ok {
                        text = helper + "(&(" + target_text + "), " + value_text_rendered + ")"
                    };
                }
            }
        }
    }

    return ExpressionResult.Ok {
        text = "(" + target_text + " " + operator.text + " " + value_text_rendered + ")"
    };
}

// --- Member access and variant references ------------------------------------

// member_expression renders a struct field access, or a qualified variant
// reference ("Enum.Case" or "Union.Variant") when the checker recorded one.
//
// The reference tests the checker's variant annotation first, so a qualified
// variant reference never renders its receiver; only a field access does. The
// receiver's position, which is the member expression's own position, is where a
// missing type annotation is reported.
fn member_expression(ExpressionContext context, int node_id, Expr receiver, Token member) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (expression_info(module, node_id).variant) {
        Present(variant) {
            match (expression_info(module, node_id).type) {
                Absent {
                    return missing_expression_type(receiver);
                }
                Present(named_type) {
                    return variant_reference(named_type, variant);
                }
            }
        }
        Absent { }
    }
    match (emit_expression(context, receiver)) {
        Failed(error) {
            return ExpressionResult.Failed { error = error };
        }
        Ok(rendered) {
            return ExpressionResult.Ok { text = "(" + rendered + ")->" + field_name(member.text) };
        }
    }
}

// variant_reference renders a payload-less variant used as a value: an enum case
// is a tag constant, and a payload-less union variant is a constructor call.
fn variant_reference(Type named_type, Variant variant) -> ExpressionResult {
    if (is_union(named_type)) {
        return ExpressionResult.Ok {
            text = variant_constructor_name(named_type, variant.name) + "()"
        };
    }
    return ExpressionResult.Ok { text = enum_case_name(named_type, variant.name) };
}

// type_ref_name returns the name a type reference was written with. A literal's
// type reference is always a named type, so the composite cases return the empty
// string and are only reachable for a tree the parser did not produce.
fn type_ref_name(TypeRef reference) -> string {
    match (reference) {
        Named(node_id, name) { return name.text; }
        Array(node_id, element) { return ""; }
        Map(node_id, keyword, key, value) { return ""; }
    }
}

// field_init_value returns the value a literal gives a field, or Absent when the
// literal does not initialize that field. The checker rejects a duplicate field,
// so the first match is the only match.
fn field_init_value(FieldInit[] fields, int field_count, string name) -> OptionalExpr {
    int index = 0;
    while (index < field_count) {
        if (fields[index].name.text == name) {
            return OptionalExpr.Present { expression = fields[index].value };
        }
        index++;
    }
    return OptionalExpr.Absent;
}

// not_checked_struct reports a struct literal whose type the checker did not
// record. The checker records a type for every literal it accepts, so this cannot
// occur for a checked program.
fn not_checked_struct(TypeRef type_ref) -> ExpressionResult {
    Position at = type_position(type_ref);
    return ExpressionResult.Failed {
        error = generate_error(at.line, at.column, "struct " + quoted(type_ref_name(type_ref)) + " was not checked")
    };
}

// struct_literal_expression renders "Struct { field = value, ... }" as a call to
// the struct's constructor, with values reordered into field declaration order.
//
// Values are located through the literal's fields, so a literal written in a
// different order than the declaration still renders in declaration order, which
// is also the order the reference interns its string literals in.
fn struct_literal_expression(ExpressionContext context, TypeRef type_ref, Token open_brace, FieldInit[] fields, int field_count) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (type_ref_type(module, type_ref_node_id(type_ref))) {
        Absent {
            return not_checked_struct(type_ref);
        }
        Present(struct_type) {
            if (!is_struct(struct_type)) {
                return not_checked_struct(type_ref);
            }
            StructInfo info = struct_info_of(struct_type);
            string arguments = "";
            int index = 0;
            while (index < info.field_count) {
                StructField field = info.fields[index];
                match (field_init_value(fields, field_count, field.name)) {
                    Absent {
                        Position at = position_of_token(open_brace);
                        return ExpressionResult.Failed {
                            error = generate_error(at.line, at.column, "struct literal for " + struct_type.name + " is missing field " + quoted(field.name))
                        };
                    }
                    Present(value) {
                        match (emit_expression(context, value)) {
                            Failed(error) {
                                return ExpressionResult.Failed { error = error };
                            }
                            Ok(rendered) {
                                if (index > 0) {
                                    arguments += ", ";
                                }
                                arguments += rendered;
                            }
                        }
                    }
                }
                index++;
            }
            return ExpressionResult.Ok {
                text = constructor_name(struct_type.name, struct_type.module) + "(" + arguments + ")"
            };
        }
    }
}

// variant_literal_expression renders "Union.Variant { field = value, ... }" as a
// call to the variant's constructor, with values reordered into field declaration
// order.
fn variant_literal_expression(ExpressionContext context, TypeRef type_ref, Token variant_token, Token open_brace, FieldInit[] fields, int field_count) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (type_ref_type(module, type_ref_node_id(type_ref))) {
        Absent {
            Position at = type_position(type_ref);
            return ExpressionResult.Failed {
                error = generate_error(at.line, at.column, "unresolved type " + quoted(type_ref_name(type_ref)))
            };
        }
        Present(union_type) {
            if (!is_union(union_type)) {
                Position at = type_position(type_ref);
                return ExpressionResult.Failed {
                    error = generate_error(at.line, at.column, type_string(union_type) + " is not a union type")
                };
            }
            if (!has(union_type.variant_index, variant_token.text)) {
                Position at = type_position(type_ref);
                return ExpressionResult.Failed {
                    error = generate_error(at.line, at.column, "union " + union_type.name + " has no variant " + quoted(variant_token.text))
                };
            }
            Variant variant = union_type.variant_index[variant_token.text];
            string arguments = "";
            int index = 0;
            while (index < variant.field_count) {
                StructField field = variant.fields[index];
                match (field_init_value(fields, field_count, field.name)) {
                    Absent {
                        Position at = position_of_token(open_brace);
                        return ExpressionResult.Failed {
                            error = generate_error(at.line, at.column, "variant literal for " + union_type.name + "." + variant.name + " is missing field " + quoted(field.name))
                        };
                    }
                    Present(value) {
                        match (emit_expression(context, value)) {
                            Failed(error) {
                                return ExpressionResult.Failed { error = error };
                            }
                            Ok(rendered) {
                                if (index > 0) {
                                    arguments += ", ";
                                }
                                arguments += rendered;
                            }
                        }
                    }
                }
                index++;
            }
            return ExpressionResult.Ok {
                text = variant_constructor_name(union_type, variant.name) + "(" + arguments + ")"
            };
        }
    }
}

// --- Array, map, and index expressions ---------------------------------------

// new_array_expression renders "new Element[length]" as a runtime allocation. The
// allocation is zero-initialized by the collector, and the element size is the one
// the type maps to in C.
fn new_array_expression(ExpressionContext context, Token at, TypeRef element_ref, Expr length) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (type_ref_type(module, type_ref_node_id(element_ref))) {
        Absent {
            Position error_at = type_position(element_ref);
            return ExpressionResult.Failed {
                error = generate_error(error_at.line, error_at.column, "unresolved type " + quoted(type_ref_name(element_ref)))
            };
        }
        Present(element_type) {
            match (c_type(element_type)) {
                Failed(message) {
                    Position error_at = position_of_token(at);
                    return ExpressionResult.Failed {
                        error = generate_error(error_at.line, error_at.column, message)
                    };
                }
                Ok(element_text) {
                    match (emit_expression(context, length)) {
                        Failed(error) {
                            return ExpressionResult.Failed { error = error };
                        }
                        Ok(rendered) {
                            return ExpressionResult.Ok {
                                text = array_new_function() + "(" + rendered + ", sizeof(" + element_text + "))"
                            };
                        }
                    }
                }
            }
        }
    }
}

// new_map_expression renders "new map[Key]Value" as a runtime allocation of an
// empty map whose values are stored inline at the value type's size.
fn new_map_expression(ExpressionContext context, Token at, TypeRef map_ref) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (type_ref_type(module, type_ref_node_id(map_ref))) {
        Absent {
            Position error_at = type_position(map_ref);
            return ExpressionResult.Failed {
                error = generate_error(error_at.line, error_at.column, "unresolved type " + quoted(type_ref_name(map_ref)))
            };
        }
        Present(map_type_value) {
            if (!is_map(map_type_value)) {
                Position error_at = position_of_token(at);
                return ExpressionResult.Failed {
                    error = generate_error(error_at.line, error_at.column, type_string(map_type_value) + " is not a map type")
                };
            }
            match (c_type(value_of(map_type_value))) {
                Failed(message) {
                    Position error_at = position_of_token(at);
                    return ExpressionResult.Failed {
                        error = generate_error(error_at.line, error_at.column, message)
                    };
                }
                Ok(value_text) {
                    return ExpressionResult.Ok {
                        text = map_new_function() + "(sizeof(" + value_text + "))"
                    };
                }
            }
        }
    }
}

// index_expression renders "target[index]".
//
// For an array, the runtime accessor performs the bounds check and returns a
// pointer to the element. For a map, it returns a pointer to the value and fails
// when the key is absent. In both cases the result is a C l-value, so compound
// assignment and increment can evaluate the target and index exactly once. A
// string index yields an int byte value directly and is not an l-value.
//
// The reference reads the target's type, the result's type, and the result's C
// type before either operand is rendered, so a mistyped node is reported before a
// string literal inside it would be interned; this mirrors that order.
fn index_expression(ExpressionContext context, int node_id, Token bracket, Expr target, Expr index) -> ExpressionResult {
    ModuleModel module = module_model(context.model, context.module_index);
    match (expression_info(module, expr_node_id(target)).type) {
        Absent {
            return missing_expression_type(target);
        }
        Present(target_type) {
            match (expression_info(module, node_id).type) {
                Absent {
                    // The reference reports the index expression's own missing
                    // type at its position, which is the target's position.
                    return missing_expression_type(target);
                }
                Present(result_type) {
                    match (c_type(result_type)) {
                        Failed(message) {
                            Position error_at = position_of_token(bracket);
                            return ExpressionResult.Failed {
                                error = generate_error(error_at.line, error_at.column, message)
                            };
                        }
                        Ok(result_text) {
                            match (emit_expression(context, target)) {
                                Failed(error) {
                                    return ExpressionResult.Failed { error = error };
                                }
                                Ok(target_text) {
                                    match (emit_expression(context, index)) {
                                        Failed(error) {
                                            return ExpressionResult.Failed { error = error };
                                        }
                                        Ok(index_text) {
                                            if (target_type.kind == TypeKind.String) {
                                                return ExpressionResult.Ok {
                                                    text = string_at_function() + "(" + target_text + ", " + index_text + ")"
                                                };
                                            }
                                            string accessor = array_at_function();
                                            if (is_map(target_type)) {
                                                accessor = map_at_function();
                                            }
                                            return ExpressionResult.Ok {
                                                text = "(*(" + "(" + result_text + " *)" + accessor + "(" + target_text + ", " + index_text + ")))"
                                            };
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// --- Calls -------------------------------------------------------------------

// HelperResult is a runtime helper's name, or the reason none applies.
union HelperResult {
    Ok { string text; }
    Failed { GenerateError error; }
}

// call_expression renders a call to a user-defined function or to a built-in.
//
// The built-ins are not ordinary calls: print becomes a comma expression of
// runtime helpers, length chooses its helper from the argument's type, and the
// others are one runtime call with their arguments in order. Anything else is a
// call to the function the checker resolved for the callee, named by the module
// that declared it.
fn call_expression(ExpressionContext context, int node_id, Expr callee, Expr[] arguments, int argument_count) -> ExpressionResult {
    BuiltinKind builtin = callee_builtin_kind(context, callee);
    if (builtin == BuiltinKind.Print) {
        return print_expression(context, arguments, argument_count);
    }
    if (builtin == BuiltinKind.Eprint) {
        return eprint_expression(context, arguments, argument_count);
    }
    if (builtin == BuiltinKind.Exit) {
        return builtin_call_expression(context, callee, exit_function(), "exit", arguments, argument_count, 1);
    }
    if (builtin == BuiltinKind.Length) {
        return length_expression(context, callee, arguments, argument_count);
    }
    if (builtin == BuiltinKind.Substring) {
        return builtin_call_expression(context, callee, substring_function(), "substring", arguments, argument_count, 3);
    }
    if (builtin == BuiltinKind.MapHas) {
        return builtin_call_expression(context, callee, map_has_function(), "has", arguments, argument_count, 2);
    }
    if (builtin == BuiltinKind.ReadFile) {
        return builtin_call_expression(context, callee, read_file_function(), "read_file", arguments, argument_count, 1);
    }
    if (builtin == BuiltinKind.Argv) {
        return ExpressionResult.Ok { text = argv_function() + "()" };
    }
    if (builtin == BuiltinKind.TryReadFile) {
        return try_read_file_expression(context, node_id, callee, arguments, argument_count);
    }
    return user_call_expression(context, callee, arguments, argument_count);
}

// try_read_file_expression lowers try_read_file(path) to the generated helper
// that builds the predeclared ReadFileResult from the runtime primitive.
fn try_read_file_expression(ExpressionContext context, int node_id, Expr callee, Expr[] arguments, int argument_count) -> ExpressionResult {
    if (argument_count < 1) {
        return wrong_builtin_arity(callee, "try_read_file", argument_count);
    }
    match (expression_info(module_model(context.model, context.module_index), node_id).type) {
        Absent {
            return missing_expression_type(callee);
        }
        Present(result_type) {
            match (emit_expression(context, arguments[0])) {
                Failed(error) {
                    return ExpressionResult.Failed { error = error };
                }
                Ok(rendered) {
                    return ExpressionResult.Ok {
                        text = prelude_try_read_file_helper_name(result_type.module) + "(" + rendered + ")"
                    };
                }
            }
        }
    }
}

// callee_builtin_kind reports which built-in a callee resolves to, or NotBuiltin
// when it is a user function or was not resolved. The checker records the resolved
// function on the callee's symbol, so this reads the model rather than the name.
fn callee_builtin_kind(ExpressionContext context, Expr callee) -> BuiltinKind {
    match (expression_info(module_model(context.model, context.module_index), expr_node_id(callee)).symbol) {
        Absent {
            return BuiltinKind.NotBuiltin;
        }
        Present(symbol) {
            match (symbol.function) {
                Absent {
                    return BuiltinKind.NotBuiltin;
                }
                Present(function) {
                    return function.builtin;
                }
            }
        }
    }
}

// callee_function returns the user function a call's callee resolved to, or absent
// when the callee is a built-in or was not resolved.
fn callee_function(ExpressionContext context, Expr callee) -> OptionalFunction {
    match (expression_info(module_model(context.model, context.module_index), expr_node_id(callee)).symbol) {
        Absent {
            return OptionalFunction.Absent;
        }
        Present(symbol) {
            match (symbol.function) {
                Absent {
                    return OptionalFunction.Absent;
                }
                Present(function) {
                    if (function.builtin != BuiltinKind.NotBuiltin) {
                        return OptionalFunction.Absent;
                    }
                    return OptionalFunction.Present { function = function };
                }
            }
        }
    }
}

// print_expression expands a print call into a comma expression that writes each
// argument, separated by single spaces and terminated by a newline. A comma
// expression has type void, matching print's return type, so it can appear wherever
// the checker allowed the call.
//
// Each argument's helper is chosen from the argument's recorded type before the
// argument is rendered, so an argument print cannot write is reported at the
// argument, as the reference reports it.
fn print_expression(ExpressionContext context, Expr[] arguments, int argument_count) -> ExpressionResult {
    string parts = "";
    int index = 0;
    while (index < argument_count) {
        Expr argument = arguments[index];
        match (expression_info(module_model(context.model, context.module_index), expr_node_id(argument)).type) {
            Absent {
                return missing_expression_type(argument);
            }
            Present(argument_type) {
                match (print_helper(argument_type)) {
                    Failed(error) {
                        return ExpressionResult.Failed { error = error };
                    }
                    Ok(helper) {
                        match (emit_expression(context, argument)) {
                            Failed(error) {
                                return ExpressionResult.Failed { error = error };
                            }
                            Ok(rendered) {
                                // Arguments are separated by the space helper, so
                                // only the first one has no separator before it.
                                if (index > 0) {
                                    parts += ", " + print_space_function() + "()";
                                    parts += ", " + helper + "(" + rendered + ")";
                                } else {
                                    parts += helper + "(" + rendered + ")";
                                }
                            }
                        }
                    }
                }
            }
        }
        index++;
    }
    if (argument_count > 0) {
        parts += ", " + print_newline_function() + "()";
    } else {
        parts += print_newline_function() + "()";
    }
    return ExpressionResult.Ok { text = "(" + parts + ")" };
}

// print_helper returns the runtime function that prints a value of the given type.
// The checker only allows int, float, bool, and string.
fn print_helper(Type value) -> HelperResult {
    if (value.kind == TypeKind.Int) {
        return HelperResult.Ok { text = print_int_function() };
    }
    if (value.kind == TypeKind.Float) {
        return HelperResult.Ok { text = print_float_function() };
    }
    if (value.kind == TypeKind.Bool) {
        return HelperResult.Ok { text = print_bool_function() };
    }
    if (value.kind == TypeKind.String) {
        return HelperResult.Ok { text = print_string_function() };
    }
    return HelperResult.Failed {
        error = generate_error(0, 0, "print does not support values of type " + type_string(value))
    };
}

// eprint_expression expands an eprint call into a comma expression that writes
// each argument to standard error, separated by single spaces and terminated by
// a flushing newline. The shape is identical to print_expression with the eprint
// helpers.
fn eprint_expression(ExpressionContext context, Expr[] arguments, int argument_count) -> ExpressionResult {
    string parts = "";
    int index = 0;
    while (index < argument_count) {
        Expr argument = arguments[index];
        match (expression_info(module_model(context.model, context.module_index), expr_node_id(argument)).type) {
            Absent {
                return missing_expression_type(argument);
            }
            Present(argument_type) {
                match (eprint_helper(argument_type)) {
                    Failed(error) {
                        return ExpressionResult.Failed { error = error };
                    }
                    Ok(helper) {
                        match (emit_expression(context, argument)) {
                            Failed(error) {
                                return ExpressionResult.Failed { error = error };
                            }
                            Ok(rendered) {
                                if (index > 0) {
                                    parts += ", " + eprint_space_function() + "()";
                                    parts += ", " + helper + "(" + rendered + ")";
                                } else {
                                    parts += helper + "(" + rendered + ")";
                                }
                            }
                        }
                    }
                }
            }
        }
        index++;
    }
    if (argument_count > 0) {
        parts += ", " + eprint_newline_function() + "()";
    } else {
        parts += eprint_newline_function() + "()";
    }
    return ExpressionResult.Ok { text = "(" + parts + ")" };
}

// eprint_helper returns the runtime function that writes a value of the given
// type to standard error.
fn eprint_helper(Type value) -> HelperResult {
    if (value.kind == TypeKind.Int) {
        return HelperResult.Ok { text = eprint_int_function() };
    }
    if (value.kind == TypeKind.Float) {
        return HelperResult.Ok { text = eprint_float_function() };
    }
    if (value.kind == TypeKind.Bool) {
        return HelperResult.Ok { text = eprint_bool_function() };
    }
    if (value.kind == TypeKind.String) {
        return HelperResult.Ok { text = eprint_string_function() };
    }
    return HelperResult.Failed {
        error = generate_error(0, 0, "eprint does not support values of type " + type_string(value))
    };
}

// length_expression renders a length call. The argument's type decides which
// runtime helper reads the length, and the argument is rendered afterwards, as the
// reference orders it.
fn length_expression(ExpressionContext context, Expr callee, Expr[] arguments, int argument_count) -> ExpressionResult {
    if (argument_count < 1) {
        return wrong_builtin_arity(callee, "length", argument_count);
    }
    Expr argument = arguments[0];
    match (expression_info(module_model(context.model, context.module_index), expr_node_id(argument)).type) {
        Absent {
            return missing_expression_type(argument);
        }
        Present(argument_type) {
            string function = array_length_function();
            if (is_map(argument_type)) {
                function = map_length_function();
            } else if (argument_type.kind == TypeKind.String) {
                function = string_length_function();
            }
            match (emit_expression(context, argument)) {
                Failed(error) {
                    return ExpressionResult.Failed { error = error };
                }
                Ok(rendered) {
                    return ExpressionResult.Ok { text = function + "(" + rendered + ")" };
                }
            }
        }
    }
}

// builtin_call_expression renders a built-in whose arguments become the arguments of
// one runtime call, in order.
//
// required is the number of arguments the checker accepts for that built-in; a call
// with fewer cannot come from a checked program, and is reported rather than
// indexed past the end of the argument array.
fn builtin_call_expression(ExpressionContext context, Expr callee, string function, string name, Expr[] arguments, int argument_count, int required) -> ExpressionResult {
    if (argument_count < required) {
        return wrong_builtin_arity(callee, name, argument_count);
    }
    string text = "";
    int index = 0;
    while (index < required) {
        match (emit_expression(context, arguments[index])) {
            Failed(error) {
                return ExpressionResult.Failed { error = error };
            }
            Ok(rendered) {
                if (index > 0) {
                    text += ", ";
                }
                text += rendered;
            }
        }
        index++;
    }
    return ExpressionResult.Ok { text = function + "(" + text + ")" };
}

// user_call_expression renders a call to a user-defined function.
//
// The reference requires the callee to be an identifier, which the checker
// guarantees, then renders the arguments in order and resolves the callee. A callee
// the model does not resolve is reported rather than named after the source text.
fn user_call_expression(ExpressionContext context, Expr callee, Expr[] arguments, int argument_count) -> ExpressionResult {
    match (callee) {
        Identifier(node_id, token) {
            string arguments_text = "";
            int index = 0;
            while (index < argument_count) {
                match (emit_expression(context, arguments[index])) {
                    Failed(error) {
                        return ExpressionResult.Failed { error = error };
                    }
                    Ok(rendered) {
                        if (index > 0) {
                            arguments_text += ", ";
                        }
                        arguments_text += rendered;
                    }
                }
                index++;
            }
            match (callee_function(context, callee)) {
                Absent {
                    Position at = position_of_token(token);
                    return ExpressionResult.Failed {
                        error = generate_error(at.line, at.column, "function " + quoted(token.text) + " was not resolved")
                    };
                }
                Present(function) {
                    return ExpressionResult.Ok {
                        text = function_name(token.text, function.module) + "(" + arguments_text + ")"
                    };
                }
            }
        }
        Integer(node_id, token) { return unsupported_call_target(callee); }
        Float(node_id, token) { return unsupported_call_target(callee); }
        String(node_id, token) { return unsupported_call_target(callee); }
        Boolean(node_id, token, value) { return unsupported_call_target(callee); }
        Unary(node_id, operator, operand, postfix) { return unsupported_call_target(callee); }
        Binary(node_id, operator, left, right) { return unsupported_call_target(callee); }
        Assign(node_id, operator, target, value) { return unsupported_call_target(callee); }
        Call(node_id, open_paren, inner_callee, inner_arguments, inner_count) { return unsupported_call_target(callee); }
        Member(node_id, dot, receiver, member) { return unsupported_call_target(callee); }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { return unsupported_call_target(callee); }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { return unsupported_call_target(callee); }
        NewArray(node_id, at, element, length) { return unsupported_call_target(callee); }
        NewMap(node_id, at, map_type) { return unsupported_call_target(callee); }
        Index(node_id, bracket, target, index) { return unsupported_call_target(callee); }
    }
}

// unsupported_call_target reports a callee that is not an identifier. The checker
// rejects such a call, so this cannot occur for a checked program.
fn unsupported_call_target(Expr callee) -> ExpressionResult {
    Position at = expr_position(callee);
    return ExpressionResult.Failed {
        error = generate_error(at.line, at.column, "unsupported call target")
    };
}

// wrong_builtin_arity reports a built-in call with fewer arguments than the checker
// accepts. The checker enforces each built-in's arity, so this cannot occur.
fn wrong_builtin_arity(Expr callee, string name, int argument_count) -> ExpressionResult {
    Position at = expr_position(callee);
    return ExpressionResult.Failed {
        error = generate_error(at.line, at.column, "the built-in " + name + " call has " + decimal(argument_count) + " argument(s), which the checker did not accept")
    };
}

// missing_expression_type reports an expression the checker did not annotate, which
// cannot occur for a tree it accepted.
fn missing_expression_type(Expr expression) -> ExpressionResult {
    Position at = expr_position(expression);
    return ExpressionResult.Failed {
        error = generate_error(at.line, at.column, "expression has no recorded type")
    };
}

// unary_expression renders a prefix or postfix unary operation. Integer
// arithmetic uses defined runtime helpers; float operations keep their C
// spelling. Increment and decrement take the address of the target so it is
// evaluated exactly once, and the helper returns the old value for postfix and
// the new value for prefix.
fn unary_expression(ExpressionContext context, Token operator, Expr operand, bool postfix) -> ExpressionResult {
    ExpressionResult rendered = emit_expression(context, operand);
    if (!expression_ok(rendered)) {
        return rendered;
    }
    ModuleModel module = module_model(context.model, context.module_index);
    match (expression_info(module, expr_node_id(operand)).type) {
        Absent {
            return missing_expression_type(operand);
        }
        Present(operand_type) {
            if (operand_type.kind == TypeKind.Int) {
                if (operator.text == "-") {
                    return ExpressionResult.Ok { text = i64_neg_function() + "(" + expression_text(rendered) + ")" };
                }
                if (operator.text == "++") {
                    if (postfix) {
                        return ExpressionResult.Ok { text = i64_post_inc_function() + "(&(" + expression_text(rendered) + "))" };
                    }
                    return ExpressionResult.Ok { text = i64_pre_inc_function() + "(&(" + expression_text(rendered) + "))" };
                }
                if (operator.text == "--") {
                    if (postfix) {
                        return ExpressionResult.Ok { text = i64_post_dec_function() + "(&(" + expression_text(rendered) + "))" };
                    }
                    return ExpressionResult.Ok { text = i64_pre_dec_function() + "(&(" + expression_text(rendered) + "))" };
                }
            }
        }
    }
    if (postfix) {
        return ExpressionResult.Ok { text = "(" + expression_text(rendered) + operator.text + ")" };
    }
    return ExpressionResult.Ok { text = "(" + operator.text + expression_text(rendered) + ")" };
}

// binary_expression renders a binary operation.
//
// Precedence is made explicit with parentheses, so the C text does not depend on
// C's precedence matching Kitten's. "+", "==", and "!=" on strings use the
// runtime helpers, because a Kitten string is a length-carrying pointer: "+"
// concatenates rather than adding addresses, and "==" compares content rather
// than pointers. Every other operator maps directly to its C spelling.
fn binary_expression(ExpressionContext context, Token operator, Expr left, Expr right) -> ExpressionResult {
    ExpressionResult rendered_left = emit_expression(context, left);
    if (!expression_ok(rendered_left)) {
        return rendered_left;
    }
    ExpressionResult rendered_right = emit_expression(context, right);
    if (!expression_ok(rendered_right)) {
        return rendered_right;
    }
    string left_text = expression_text(rendered_left);
    string right_text = expression_text(rendered_right);

    if (operator.text == "+" || operator.text == "==" || operator.text == "!=") {
        OperandKind kind = left_operand_kind(context, left);
        match (kind) {
            String {
                if (operator.text == "+") {
                    return ExpressionResult.Ok { text = string_concat_function() + "(" + left_text + ", " + right_text + ")" };
                }
                if (operator.text == "==") {
                    return ExpressionResult.Ok { text = string_equal_function() + "(" + left_text + ", " + right_text + ")" };
                }
                return ExpressionResult.Ok { text = "!" + string_equal_function() + "(" + left_text + ", " + right_text + ")" };
            }
            NotString { }
            Missing(error) {
                return ExpressionResult.Failed { error = error };
            }
        }
    }

    ModuleModel module = module_model(context.model, context.module_index);
    match (expression_info(module, expr_node_id(left)).type) {
        Absent {
            return missing_expression_type(left);
        }
        Present(operand_type) {
            if (operand_type.kind == TypeKind.Int) {
                if (operator.text == "+") {
                    return ExpressionResult.Ok { text = i64_add_function() + "(" + left_text + ", " + right_text + ")" };
                }
                if (operator.text == "-") {
                    return ExpressionResult.Ok { text = i64_sub_function() + "(" + left_text + ", " + right_text + ")" };
                }
                if (operator.text == "*") {
                    return ExpressionResult.Ok { text = i64_mul_function() + "(" + left_text + ", " + right_text + ")" };
                }
                if (operator.text == "/") {
                    return ExpressionResult.Ok { text = i64_div_function() + "(" + left_text + ", " + right_text + ")" };
                }
                if (operator.text == "%") {
                    return ExpressionResult.Ok { text = i64_mod_function() + "(" + left_text + ", " + right_text + ")" };
                }
            }
        }
    }

    return ExpressionResult.Ok { text = "(" + left_text + " " + operator.text + " " + right_text + ")" };
}

// OperandKind is what the left operand's resolved type means for a binary
// operator: a string operand selects the runtime helpers, any other operand maps
// directly, and an operand the checker did not annotate is a failure.
union OperandKind {
    String
    NotString
    Missing { GenerateError error; }
}

// left_operand_kind reports how the left operand of "+", "==", or "!=" is
// treated. The reference reads the left operand's recorded type for exactly these
// three operators and reports a missing annotation as an error, which cannot
// happen for a tree the checker accepted.
fn left_operand_kind(ExpressionContext context, Expr left) -> OperandKind {
    match (expression_info(module_model(context.model, context.module_index), expr_node_id(left)).type) {
        Absent {
            Position at = expr_position(left);
            return OperandKind.Missing {
                error = generate_error(at.line, at.column, "expression has no recorded type")
            };
        }
        Present(operand_type) {
            if (operand_type.kind == TypeKind.String) {
                return OperandKind.String;
            }
            return OperandKind.NotString;
        }
    }
}
