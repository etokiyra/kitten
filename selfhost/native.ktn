// native.ktn - the native-backend probe driver.
//
// It builds the Phase 10.1 scene corpus with the Kitten-written typed-IR
// module, runs check_scene over it, and prints the deterministic text
// rendering. With one argument, it builds one of the failure scenes instead
// and prints check_scene's message, so the tests can pin the validation
// texts. With `elf <path>`, it lowers and assembles the skeleton target's
// scene into a static ELF64 executable and writes that file directly, with
// no C compiler anywhere; `elf-arith` and `elf-divzero` do the same for the
// Phase 10.3 scenes that exercise arithmetic, comparisons, control flow,
// calls, and the guarded divide failure.
//
//     native                  print the valid scene's rendering
//     native <mode>           print one failure scene's check message
//     native elf <path>       write the skeleton target's executable
//     native elf-arith ...    write the arithmetic-and-control-flow executable
//     native elf-divzero ...  write the divide-failure executable
//     native big              render the growth corpus
//     native arith            render the arithmetic-and-control-flow scene
//
// Modes: no-label, bad-binding, bad-call-count, bad-call-shape, bad-entry,
// undefined-label. This is test infrastructure: the rendering and error
// messages go to standard output and standard error stays empty.

import "loader/loader.ktn";
import "native/ir.ktn";
import "native/text.ktn";
import "native/selector.ktn";
import "native/elf.ktn";

// one_ref_parameter is a parameter-shape list holding exactly one reference.
fn one_ref_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Ref;
    return shapes;
}

// one_int_parameter is a parameter-shape list holding exactly one int.
fn one_int_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Int;
    return shapes;
}

// add_print appends the runtime-shaped print routine to a scene: it reads
// the string object's length and pointer and performs two write syscalls,
// the payload and then the newline blob's payload. hello and arith share
// it so their program shape stays identical.
fn add_print(NativeScene scene, int newline_blob) -> int {
    int print = add_function(scene, "print", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction print_function = function_at(scene, print);

    int length_binding = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawLoad64 { target = length_binding, address = 0, offset = 0 });
    int data_binding = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.RawLoad64 { target = data_binding, address = 0, offset = 8 });

    int one = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = one, value = 1 });
    int write = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = write, value = 1 });
    int[] write_arguments = new int[3];
    write_arguments[0] = one;
    write_arguments[1] = data_binding;
    write_arguments[2] = length_binding;
    int first = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawSyscall { target = first, number = write, arguments = write_arguments, argument_count = 3 });

    int newline_ref = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.ConstRefData { target = newline_ref, blob = newline_blob });
    // The payload pointer sits behind the object header, exactly as for
    // print's own string; load it before the write.
    int newline_data = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.RawLoad64 { target = newline_data, address = newline_ref, offset = 8 });
    int one_again = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = one_again, value = 1 });
    int count_one = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = count_one, value = 1 });
    int[] newline_arguments = new int[3];
    newline_arguments[0] = one_again;
    newline_arguments[1] = newline_data;
    newline_arguments[2] = count_one;
    int second = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawSyscall { target = second, number = write, arguments = newline_arguments, argument_count = 3 });

    push_instruction(print_function, Instruction.ReturnVoid);
    return print;
}

// build_hello is the skeleton target's scene per the 10.2 slice: static
// blobs for a string literal and the newline, the shared print routine, and
// an entry that binds the literal and calls print.
fn build_hello() -> NativeScene {
    NativeScene scene = new_scene();
    int hello = add_blob(scene, "hello");
    int newline = add_blob(scene, "\n");

    int print = add_print(scene, newline);

    int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
    NativeFunction main_function = function_at(scene, main);

    int text = new_temporary(main_function, NativeType.Ref);
    push_instruction(main_function, Instruction.ConstRefData { target = text, blob = hello });
    int[] arguments = new int[1];
    arguments[0] = text;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = arguments, argument_count = 1 });
    push_instruction(main_function, Instruction.ReturnVoid);

    scene.entry = main;
    return scene;
}

// build_big is the growth probe: more functions, bindings, and blobs than
// each table's first allocation, so every doubling path in the scene builder
// runs.
fn build_big() -> NativeScene {
    NativeScene scene = new_scene();
    int blob = 0;
    while (blob < 9) {
        add_blob(scene, substring("ab", blob % 2, blob % 2 + 1));
        blob++;
    }

    int count = 12;
    int index = 0;
    while (index < count) {
        int function = add_function(scene, "f" + decimal(index), NativeType.Int, new NativeType[0], 0);
        NativeFunction handle = function_at(scene, function);
        // Seventeen temporaries exceed the first binding allocation, so the
        // binding table doubles inside every function.
        int temporary = 0;
        while (temporary < 17) {
            int binding = new_temporary(handle, NativeType.Int);
            push_instruction(handle, Instruction.ConstInt { target = binding, value = index * 17 + temporary });
            temporary++;
        }
        push_instruction(handle, Instruction.Return { value = 16 });
        index++;
    }
    scene.entry = 0;
    return scene;
}

// build_arith mirrors a non-allocating control-flow program: a loop that
// calls a helper and folds it through defined divide, remainder, and add,
// then two comparisons that print one of three strings. Every Phase 10.3
// instruction form — multiply, subtract, divide, remainder, add, negate,
// equal, less_than, branch, jump, label — and the skeleton's call and
// constant forms appear in its lowering. It mirrors this Kitten program:
//
//     fn step(value int) -> int {
//         return value * 3 - 1;
//     }
//     fn main() {
//         int total = 47;
//         int round = 0;
//         while (round < 5) {
//             total = step(total) / 5 + total % 5;
//             round = round + 1;
//         }
//         if (total > 19) {
//             print("large");
//         } else {
//             print("small");
//         }
//         int under = -1;
//         int flipped = total / under;
//         int remains = total % under;
//         if (flipped < remains) {
//             print("negged");
//         }
//     }
fn build_arith() -> NativeScene {
    NativeScene scene = new_scene();
    int newline = add_blob(scene, "\n");
    int large = add_blob(scene, "large");
    int small = add_blob(scene, "small");
    int negged = add_blob(scene, "negged");

    int print = add_print(scene, newline);

    int step = add_function(scene, "step", NativeType.Int, one_int_parameter(), 1);
    NativeFunction step_function = function_at(scene, step);
    int three = new_temporary(step_function, NativeType.Int);
    push_instruction(step_function, Instruction.ConstInt { target = three, value = 3 });
    int tripled = new_temporary(step_function, NativeType.Int);
    push_instruction(step_function, Instruction.Multiply { target = tripled, left = 0, right = three });
    int minus_one = new_temporary(step_function, NativeType.Int);
    push_instruction(step_function, Instruction.ConstInt { target = minus_one, value = 1 });
    int stepped = new_temporary(step_function, NativeType.Int);
    push_instruction(step_function, Instruction.Subtract { target = stepped, left = tripled, right = minus_one });
    push_instruction(step_function, Instruction.Return { value = stepped });

    int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
    NativeFunction main_function = function_at(scene, main);

    int total = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = total, value = 47 });
    int round = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = round, value = 0 });
    int five = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = five, value = 5 });
    int one = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = one, value = 1 });
    push_instruction(main_function, Instruction.Label { label = 0 });
    int cond = new_temporary(main_function, NativeType.Bool);
    push_instruction(main_function, Instruction.LessThan { target = cond, left = round, right = five });
    push_instruction(main_function, Instruction.Branch { condition = cond, label_true = 1, label_false = 2 });
    push_instruction(main_function, Instruction.Label { label = 1 });
    int stepped_call = new_temporary(main_function, NativeType.Int);
    int[] step_arguments = new int[1];
    step_arguments[0] = total;
    push_instruction(main_function, Instruction.Call { target = stepped_call, function = step, arguments = step_arguments, argument_count = 1 });
    int quotient = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.WholeDivide { target = quotient, left = stepped_call, right = five });
    int remainder = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.WholeRemainder { target = remainder, left = total, right = five });
    push_instruction(main_function, Instruction.Add { target = total, left = quotient, right = remainder });
    push_instruction(main_function, Instruction.Add { target = round, left = round, right = one });
    push_instruction(main_function, Instruction.Jump { label = 0 });
    push_instruction(main_function, Instruction.Label { label = 2 });
    int nineteen = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = nineteen, value = 19 });
    int over = new_temporary(main_function, NativeType.Bool);
    push_instruction(main_function, Instruction.LessThan { target = over, left = nineteen, right = total });
    push_instruction(main_function, Instruction.Branch { condition = over, label_true = 3, label_false = 4 });
    push_instruction(main_function, Instruction.Label { label = 3 });
    int large_text = new_temporary(main_function, NativeType.Ref);
    push_instruction(main_function, Instruction.ConstRefData { target = large_text, blob = large });
    int[] one_argument = new int[1];
    one_argument[0] = large_text;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = one_argument, argument_count = 1 });
    push_instruction(main_function, Instruction.Jump { label = 5 });
    push_instruction(main_function, Instruction.Label { label = 4 });
    int small_text = new_temporary(main_function, NativeType.Ref);
    push_instruction(main_function, Instruction.ConstRefData { target = small_text, blob = small });
    one_argument[0] = small_text;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = one_argument, argument_count = 1 });
    push_instruction(main_function, Instruction.Label { label = 5 });
    // A minus-one divisor: the selector's wrap path covers every dividend,
    // so both lowering paths are exercised on non-extreme values too. The
    // loop's dead bindings are reused for the folded values: stepped_call
    // takes the quotient, quotient the remainder, nineteen the divisor, and
    // over the new condition.
    push_instruction(main_function, Instruction.Negate { target = nineteen, value = one });
    push_instruction(main_function, Instruction.WholeDivide { target = stepped_call, left = total, right = nineteen });
    push_instruction(main_function, Instruction.WholeRemainder { target = quotient, left = total, right = nineteen });
    push_instruction(main_function, Instruction.LessThan { target = over, left = stepped_call, right = quotient });
    push_instruction(main_function, Instruction.Branch { condition = over, label_true = 6, label_false = 7 });
    push_instruction(main_function, Instruction.Label { label = 6 });
    push_instruction(main_function, Instruction.ConstRefData { target = large_text, blob = negged });
    one_argument[0] = large_text;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = one_argument, argument_count = 1 });
    push_instruction(main_function, Instruction.Label { label = 7 });
    push_instruction(main_function, Instruction.ReturnVoid);

    scene.entry = main;
    return scene;
}

// build_divzero is the guard program: a constant divisor gives the spec's
// fatal divide, so the executable must fail with the C runtime's exact
// text, standard error only, and status 1. It mirrors:
//
//     fn main() {
//         int zero = 0;
//         print(5 / zero);
//     }
fn build_divzero() -> NativeScene {
    NativeScene scene = new_scene();
    int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
    NativeFunction main_function = function_at(scene, main);

    int five = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = five, value = 5 });
    int zero = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.ConstInt { target = zero, value = 0 });
    int quotient = new_temporary(main_function, NativeType.Int);
    push_instruction(main_function, Instruction.WholeDivide { target = quotient, left = five, right = zero });
    push_instruction(main_function, Instruction.ReturnVoid);

    scene.entry = main;
    return scene;
}

// build_simple pins the argument-array shape: one array, two writes, two
// calls, so the render shows whether a later array write reaches an
// instruction pushed earlier through the same array reference.
fn build_simple() -> NativeScene {
    NativeScene scene = new_scene();
    int newline = add_blob(scene, "\n");
    int one = add_blob(scene, "one");
    int two = add_blob(scene, "two");
    int print = add_print(scene, newline);

    int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
    NativeFunction main_function = function_at(scene, main);

    int first = new_temporary(main_function, NativeType.Ref);
    push_instruction(main_function, Instruction.ConstRefData { target = first, blob = one });
    int[] shared = new int[1];
    shared[0] = first;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = shared, argument_count = 1 });
    int second = new_temporary(main_function, NativeType.Ref);
    push_instruction(main_function, Instruction.ConstRefData { target = second, blob = two });
    shared[0] = second;
    push_instruction(main_function, Instruction.CallVoid { function = print, arguments = shared, argument_count = 1 });
    push_instruction(main_function, Instruction.ReturnVoid);

    scene.entry = main;
    return scene;
}

// decimal renders a non-negative integer in decimal.
fn decimal(int value) -> string {
    if (value == 0) {
        return "0";
    }
    string result = "";
    while (value > 0) {
        int digit = value % 10;
        result = substring("0123456789", digit, digit + 1) + result;
        value = value / 10;
    }
    return result;
}

// failure_scene returns the broken scene a mode names. The check machinery
// reports the deterministic message the tests pin.
fn failure_scene(string mode) -> NativeScene {
    if (mode == "no-label") {
        NativeScene scene = new_scene();
        int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        NativeFunction main_function = function_at(scene, main);
        push_instruction(main_function, Instruction.Jump { label = 0 });
        push_instruction(main_function, Instruction.ReturnVoid);
        scene.entry = main;
        return scene;
    }

    if (mode == "bad-binding") {
        NativeScene scene = new_scene();
        int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        NativeFunction main_function = function_at(scene, main);
        push_instruction(main_function, Instruction.ConstBool { target = 0, value = true });
        push_instruction(main_function, Instruction.ReturnVoid);
        scene.entry = main;
        return scene;
    }

    if (mode == "bad-call-count") {
        NativeScene scene = new_scene();
        int print = add_function(scene, "print", NativeType.Void, one_ref_parameter(), 1);
        int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        NativeFunction main_function = function_at(scene, main);
        push_instruction(main_function, Instruction.CallVoid { function = print, arguments = new int[1], argument_count = 0 });
        push_instruction(main_function, Instruction.ReturnVoid);
        scene.entry = main;
        return scene;
    }

    if (mode == "bad-call-shape") {
        NativeScene scene = new_scene();
        int print = add_function(scene, "print", NativeType.Void, one_ref_parameter(), 1);
        int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        NativeFunction main_function = function_at(scene, main);
        int not_a_ref = new_temporary(main_function, NativeType.Bool);
        int[] arguments = new int[1];
        arguments[0] = not_a_ref;
        push_instruction(main_function, Instruction.CallVoid { function = print, arguments = arguments, argument_count = 1 });
        push_instruction(main_function, Instruction.ReturnVoid);
        scene.entry = main;
        return scene;
    }

    if (mode == "bad-entry") {
        NativeScene scene = new_scene();
        add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        scene.entry = 5;
        return scene;
    }

    if (mode == "undefined-label") {
        NativeScene scene = new_scene();
        int main = add_function(scene, "main", NativeType.Void, new NativeType[0], 0);
        NativeFunction main_function = function_at(scene, main);
        int condition = new_temporary(main_function, NativeType.Bool);
        push_instruction(main_function, Instruction.ConstBool { target = condition, value = true });
        // Label 0 exists once the Label instruction is appended, but the
        // branch asks for label 1, which is never defined.
        push_instruction(main_function, Instruction.Branch { condition = condition, label_true = 1, label_false = 0 });
        push_instruction(main_function, Instruction.Label { label = 0 });
        push_instruction(main_function, Instruction.ReturnVoid);
        scene.entry = main;
        return scene;
    }

    NativeScene empty = new_scene();
    return empty;
}

// run_elf lowers the given scene, assembles its ELF, and writes the file
// with no C compiler involved anywhere.
fn run_elf(NativeScene scene, string path) {
    match (check_scene(scene)) {
        Failed(message) {
            eprint("native: " + message);
            exit(1);
        }
        Ok {
            match (select_scene(scene)) {
                Failed(message) {
                    eprint("native: " + message);
                    exit(1);
                }
                Ok(selection) {
                    match (assemble(selection)) {
                        Failed(message) {
                            eprint("native: " + message);
                            exit(1);
                        }
                        Ok(bytes) {
                            // The file bytes are raw binary and may hold NUL
                            // bytes anywhere, so they go through the raw
                            // byte writer, not the text writer.
                            match (try_write_bytes(path, to_array(bytes))) {
                                Failed(message) {
                                    eprint("native: " + message);
                                    exit(1);
                                }
                                Ok {
                                    print("built " + path);
                                    exit(0);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn main() {
    string[] arguments = argv();
    if (length(arguments) > 3) {
        eprint("native: expected at most two arguments");
        exit(2);
    }

    if (length(arguments) == 3) {
        if (arguments[1] == "elf") {
            run_elf(build_hello(), arguments[2]);
        } else if (arguments[1] == "elf-arith") {
            run_elf(build_arith(), arguments[2]);
        } else if (arguments[1] == "elf-divzero") {
            run_elf(build_divzero(), arguments[2]);
        } else {
            eprint("native: unknown mode " + arguments[1]);
            exit(2);
        }
    }

    bool failure_mode = false;
    NativeScene scene = build_hello();
    if (length(arguments) == 2) {
        if (arguments[1] == "big") {
            scene = build_big();
        } else if (arguments[1] == "arith") {
            scene = build_arith();
        } else if (arguments[1] == "simple") {
            scene = build_simple();
        } else {
            failure_mode = true;
            scene = failure_scene(arguments[1]);
        }
    }

    match (check_scene(scene)) {
        Failed(message) {
            print("error " + message);
            exit(1);
        }
        Ok {
            if (failure_mode) {
                print("ok");
                exit(0);
            }
            print(render(scene));
            exit(0);
        }
    }
}