    push_instruction(h, Instruction.Jump { label = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Copy { target = div_t, source = zero });
    push_instruction(h, Instruction.Label { label = 5 });
