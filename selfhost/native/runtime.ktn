    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int five = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = five, value = 5 });
    int dbl = new_temporary(h, NativeType.Int);
    int[] mul_args = new int[2];
    mul_args[0] = 1;
    mul_args[1] = two;
    push_instruction(h, Instruction.Call { target = dbl, function = bn_mul_small, arguments = mul_args, argument_count = 2 });
    int[] cmp_args = new int[2];
    cmp_args[0] = dbl;
    cmp_args[1] = 2;
    int cmp = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = cmp, function = bn_cmp, arguments = cmp_args, argument_count = 2 });
    int low = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = low, left = cmp, right = zero });
    push_instruction(h, Instruction.Branch { condition = low, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.ConstInt { target = cmp, value = 0 });
    push_instruction(h, Instruction.Return { value = cmp });
    push_instruction(h, Instruction.Label { label = 1 });
    int high = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = high, left = zero, right = cmp });
    push_instruction(h, Instruction.Branch { condition = high, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    int[] bump_args = new int[1];
    bump_args[0] = 0;
    push_instruction(h, Instruction.Call { target = dbl, function = bn_bump, arguments = bump_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = dbl });
    push_instruction(h, Instruction.Label { label = 3 });
    // Exact half: round up when the sixth digit is odd.
    int[] get_args = new int[2];
    get_args[0] = 0;
    get_args[1] = five;
    int last_digit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = last_digit, function = bn_get, arguments = get_args, argument_count = 2 });
    int parity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = parity, left = last_digit, right = two });
    int odd = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = odd, left = parity, right = one });
    push_instruction(h, Instruction.Branch { condition = odd, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    bump_args[0] = 0;
    push_instruction(h, Instruction.Call { target = dbl, function = bn_bump, arguments = bump_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = dbl });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.ConstInt { target = cmp, value = 0 });
    push_instruction(h, Instruction.Return { value = cmp });
    return shell;
}

