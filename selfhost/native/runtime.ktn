// float_px registers "$float_px": the value's decimal exponent X with
// 10^X <= |value| < 10^(X+1). The estimate comes from the exponent field
// (the subnormal band centers wide, so a wide search window covers it),
// then a probe walk settles the boundary: one down to the first miss, one
// up to the first hit. Locals: 14.
// float_px registers "$float_px": the value's decimal exponent X with
// 10^X <= |value| < 10^(X+1). The estimate comes from float_e, the
// subnormal band centers wide, then a probe walk settles the boundary.
// Locals: 13.
fn add_float_px_shell(NativeScene scene, int px_probe, int float_e, int float_mantissa) -> int {
    int shell = add_function(scene, "$float_px", NativeType.Int, float_int_int_parameters(), 3);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one_c = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one_c, value = 1 });
    int fifty_two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = fifty_two, value = 4503599627370496 });
    int mant = new_temporary(h, NativeType.Int);
    int[] mant_args = new int[1];
    mant_args[0] = 0;
    push_instruction(h, Instruction.Call { target = mant, function = float_mantissa, arguments = mant_args, argument_count = 1 });
    int sub = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = sub, left = mant, right = fifty_two });
    int est = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Branch { condition = sub, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.ConstInt { target = est, value = -315 });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    int e = new_temporary(h, NativeType.Int);
    int[] e_args = new int[1];
    e_args[0] = 0;
    push_instruction(h, Instruction.Call { target = e, function = float_e, arguments = e_args, argument_count = 1 });
    int log_mul = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 30103 });
    int log_share = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = log_share, left = e, right = log_mul });
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 1580000 });
    push_instruction(h, Instruction.Add { target = log_share, left = log_share, right = log_mul });
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 100000 });
    push_instruction(h, Instruction.WholeDivide { target = est, left = log_share, right = log_mul });
    push_instruction(h, Instruction.Add { target = est, left = est, right = one_c });
    push_instruction(h, Instruction.Add { target = est, left = est, right = one_c });
    push_instruction(h, Instruction.Label { label = 2 });
    int k = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = k, source = est });
    int[] probe_args = new int[3];
    probe_args[0] = 1;
    probe_args[1] = 2;
    probe_args[2] = k;
    int hit = new_temporary(h, NativeType.Int);
    // Bidirectional walk: probe is monotonic (1 for k <= X). If probe(k)
    // hits, walk up while probe(k+1) hits; if it misses, walk down until
    // probe(k) hits. Returns X.
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Call { target = hit, function = px_probe, arguments = probe_args, argument_count = 3 });
    push_instruction(h, Instruction.Equal { target = sub, left = hit, right = zero });
    push_instruction(h, Instruction.Branch { condition = sub, label_true = 4, label_false = 5 });
    // probe(k) missed -> walk down
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Subtract { target = k, left = k, right = one_c });
    push_instruction(h, Instruction.Copy { target = probe_args[2], source = k });
    push_instruction(h, Instruction.Jump { label = 3 });
    // probe(k) hit -> walk up while probe(k+1) hits
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Add { target = k, left = k, right = one_c });
    push_instruction(h, Instruction.Copy { target = probe_args[2], source = k });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.Call { target = hit, function = px_probe, arguments = probe_args, argument_count = 3 });
    push_instruction(h, Instruction.Equal { target = sub, left = hit, right = one_c });
    push_instruction(h, Instruction.Branch { condition = sub, label_true = 7, label_false = 8 });
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Add { target = k, left = k, right = one_c });
    push_instruction(h, Instruction.Copy { target = probe_args[2], source = k });
    push_instruction(h, Instruction.Jump { label = 6 });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.Subtract { target = k, left = k, right = one_c });
    push_instruction(h, Instruction.Return { value = k });
    return shell;
}
