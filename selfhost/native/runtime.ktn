// float_round registers "$float_round": answers 0 when the digits stand,
// and the bump result (1 or 2) when one round-up applies. Parameters: 0 the
// digit buffer, 1 the fraction remainder after six digits, 2 the norm
// divisor. The half test doubles the remainder and compares with the
// divisor; the exact half rounds to the neighboring even sixth digit.
// Locals: 10.
fn add_float_round_shell(NativeScene scene, int bn_mul_small, int bn_cmp, int bn_get, int bn_bump) -> int {
    int shell = add_function(scene, "$float_round", NativeType.Int, three_int_parameters(), 3);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
