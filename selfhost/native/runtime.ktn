    push_instruction(h, Instruction.Branch { condition = positive, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Call { target = p, function = bn_shift_up, arguments = shift_args, argument_count = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Return { value = p });
