    push_instruction(h, Instruction.ConstInt { target = i, value = 1 });
    int[] re_args = new int[2];
    re_args[0] = 3;
    re_args[1] = i;
    push_instruction(h, Instruction.Label { label = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = five });
