    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = base, value = 65536 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = four, value = 4 });

    int m = new_temporary(h, NativeType.Int);
    int[] man_args = new int[1];
    man_args[0] = 0;
    push_instruction(h, Instruction.Call { target = m, function = float_mantissa, arguments = man_args, argument_count = 1 });
    int e = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = e, function = float_e, arguments = man_args, argument_count = 1 });

    int l0 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = l0, left = m, right = base });
    int q1 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = q1, left = m, right = base });
    int l1 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = l1, left = q1, right = base });
    int q2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = q2, left = q1, right = base });

    int p = new_temporary(h, NativeType.Int);
    int[] new_args = new int[1];
    push_instruction(h, Instruction.ConstInt { target = one, value = 4 });
    new_args[0] = one;
    push_instruction(h, Instruction.Call { target = p, function = bn_new, arguments = new_args, argument_count = 1 });

    int[] set_args = new int[3];
    set_args[0] = p;
    set_args[1] = zero;
    set_args[2] = l0;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    set_args[1] = one;
    set_args[2] = l1;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    // l2 reuses l0's slot
    push_instruction(h, Instruction.WholeRemainder { target = l0, left = q2, right = base });
    push_instruction(h, Instruction.ConstInt { target = one, value = 2 });
    set_args[1] = one;
    set_args[2] = l0;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    // l3 reuses l1's slot
    push_instruction(h, Instruction.WholeDivide { target = l1, left = q2, right = base });
    push_instruction(h, Instruction.ConstInt { target = one, value = 3 });
    set_args[1] = one;
    set_args[2] = l1;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });

    new_args[0] = p;
    push_instruction(h, Instruction.CallVoid { function = bn_trim, arguments = new_args, argument_count = 1 });

    int positive = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = positive, left = zero, right = e });
