// ir.ktn - the typed scene and its well-formedness checks.
//
// This is the native backend's input representation: every checked program is
// reduced later into one NativeScene of functions, bindings, labeled
// instructions, and static data blobs, and — per
// proposals/zero-dependency-toolchain.md Section 5 — every later stage, the
// layout pass, the selector, and the ELF writer, reads this one scene. The
// shapes follow Section 5.2 and the layout table in Section 5.3: int is a
// signed 64-bit value, float is IEEE 754 binary64, bool is one unsigned byte,
// enum values are signed 64-bit tags, and every string, struct, union, array,
// and map reference is an 8-byte pointer.
//
// Bindings are stack slots by default, as the proposal fixes them: every
// binding is an index into its function's binding table, parameters come
// first, and temporaries extend that table in creation order. Every
// instruction names its target binding and its operand bindings, so the scene
// is three-address and index-addressed: the renderer, the layout pass, and the
// x86-64 selector can walk the same representation deterministically.
//
// What this slice does not carry yet: float printing and conversions (the
// littlest runtime work), struct and union field access, allocation, bounds
// checks, tag switches, and runtime-module intrinsics. Float values
// themselves — literals, arithmetic, and comparisons — since the Phase 10.5
// slice lower, select, and run. The instruction union is open; each later
// slice adds its forms together with the selectors that lower them, and
// this file's validation grows with them.

// NativeType names one of the value shapes the IR carries.
public union NativeType {
    Int {}
    Float {}
    Bool {}
    Ref {}
    Void {}
}

// type_name is the renderer's stable spelling for each shape.
public fn type_name(NativeType value) -> string {
    match (value) {
        Int { return "int"; }
        Float { return "float64"; }
        Bool { return "bool"; }
        Ref { return "ref"; }
        Void { return "void"; }
    }
}

// type_size is a value's size in bytes, exactly as Section 5.3's layout table
// fixes them.
public fn type_size(NativeType value) -> int {
    match (value) {
        Int { return 8; }
        Float { return 8; }
        Bool { return 1; }
        Ref { return 8; }
        Void { return 0; }
    }
}

// type_alignment is a value's alignment in bytes from the same table.
public fn type_alignment(NativeType value) -> int {
    match (value) {
        Int { return 8; }
        Float { return 8; }
        Bool { return 1; }
        Ref { return 8; }
        Void { return 0; }
    }
}

// blob_total is a blob's whole mapped byte size under the object-header ABI
// the proposal's Section 5.3 fixes and SPEC Section 19.10 records: every data
// blob is one runtime object with an 8-byte header, an 8-byte length, an
// 8-byte payload pointer, and the payload, all rounded up to eight. The
// header word holds this whole size, so GetStatic and SetStatic bound their
// offsets against it and the selector fills it while laying out the file.
public fn blob_total(NativeScene scene, int blob) -> int {
    int size = 24 + length(scene.blobs[blob].bytes);
    int pad = (8 - size % 8) % 8;
    return size + pad;
}

// Instruction is one three-address instruction.
//
// Binding indices point into the enclosing function's binding table. Label
// indices point into the function's label set. A call names its callee by
// scene function index; the argument bindings must match the callee's
// parameter shapes, and a typed call's target matches the callee's result
// shape. ConstRefData binds a reference binding to one static data blob's
// address, which is how a lowered string literal reaches the data section.
// Forward calls are legal because check_scene runs once, after every function
// exists.
//
// The two raw instructions carry the compiler's own runtime layer:
// RawLoad64 reads one 8-byte slot at a reference-or-int address plus a small
// constant offset, and RawSyscall makes one raw Linux syscall. Neither belongs
// in user code. The scene is produced by the backend itself, so the scene does
// not police who may use them; the checker-level runtime-module gate remains
// the user-facing boundary, and no selector lowers a user program through
// raw instructions.
//
// The Phase 10.6 runtime-foundation forms complete the runtime layer:
// GetStatic reads one 8-byte slot from a data blob's payload at a raw,
// scene-relative byte offset and SetStatic writes one, which is how the
// lowering's allocator keeps its heap cursor in mutable scene data — the
// language has no globals, so the cursor is backend-owned static memory —
// and FailOOM jumps to the selector's out-of-memory paragraph, whose halt is
// the C runtime's `purr: out of memory` text at status 1.
//
// The Phase 10.7 collector forms round the raw layer out: RawStore64 writes
// one 8-byte slot at a dynamic address plus a small constant offset (the
// mirrored store to RawLoad64), RawLoad8 and RawStore8 read and write one
// byte at a dynamic address (byte-granularity for string data and the
// collector's mark bytes), and StackPointer reads the current stack pointer
// so the collector can capture and walk the live frames once, at mapping
// time. Addresses flow as ints or refs; Add and Subtract fold either shape
// because a pointer and its stack-slot reading are the same 64-bit value.
// The Phase 10.8 formatting forms: FloatBits moves one float binding's
// IEEE 754 bit pattern into an int binding, which is how the formatter's
// shells decompose sign, exponent, and mantissa with the plain integer
// arithmetic the scene already carries — no SSE2 integer conversion, and
// no user-visible bitcast.
public union Instruction {
    ConstInt { int target; int value; }
    ConstBool { int target; bool value; }
    ConstRefData { int target; int blob; }
    ConstFloat { int target; int bits; }
    Copy { int target; int source; }
    Add { int target; int left; int right; }
    Subtract { int target; int left; int right; }
    Multiply { int target; int left; int right; }
    WholeDivide { int target; int left; int right; }
    WholeRemainder { int target; int left; int right; }
    AddFloat { int target; int left; int right; }
    SubtractFloat { int target; int left; int right; }
    MultiplyFloat { int target; int left; int right; }
    DivideFloat { int target; int left; int right; }
    Negate { int target; int value; }
    NegateFloat { int target; int value; }
    Equal { int target; int left; int right; }
    LessThan { int target; int left; int right; }
    EqualFloat { int target; int left; int right; }
    GreaterFloat { int target; int left; int right; }
    LessOrEqualFloat { int target; int left; int right; }
    Call { int target; int function; int[] arguments; int argument_count; }
    CallVoid { int function; int[] arguments; int argument_count; }
    RawLoad64 { int target; int address; int offset; }
    GetStatic { int target; int blob; int offset; }
    SetStatic { int blob; int offset; int value; }
    FailOOM { }
    RawStore64 { int address; int offset; int value; }
    RawLoad8 { int target; int address; int offset; }
    RawStore8 { int address; int offset; int value; }
    StackPointer { int target; }
    FloatBits { int target; int value; }
    RawSyscall { int target; int number; int[] arguments; int argument_count; }
    Jump { int label; }
    Branch { int condition; int label_true; int label_false; }
    Label { int label; }
    Return { int value; }
    ReturnVoid {}
}

// DataBlob is one static data object. The name is the renderer's global
// spelling and the bytes are the raw payload; the data-section layout later
// associates blobs with the object shapes the runtime defines.
public struct DataBlob {
    string name;
    string bytes;
}

// NativeFunction is one routine: its result shape, its parameter bindings,
// its local bindings in creation order, and its instructions in program
// order. The label count records how many distinct labels the function
// defines; push_instruction keeps it current as Label instructions are added.
public struct NativeFunction {
    string name;
    NativeType result;
    NativeType[] parameter_types;
    int parameter_count;
    NativeType[] binding_types;
    int binding_count;
    int binding_capacity;
    int label_count;
    Instruction[] instructions;
    int instruction_count;
    int instruction_capacity;
}

// NativeScene is the whole program: ordered functions, ordered blobs, and the
// entry function's index. Function order is deterministic because the builder
// adds functions in a fixed order.
public struct NativeScene {
    NativeFunction[] functions;
    int function_count;
    int function_capacity;
    DataBlob[] blobs;
    int blob_count;
    int blob_capacity;
    int entry;
}

// SceneResult is the well-formedness pass's outcome, or the first failure's
// deterministic message, naming the scene position that failed.
public union SceneResult {
    Ok {}
    Failed { string message; }
}

// decimal renders a non-negative integer in decimal. The builder's counters
// and indices are never negative, so negative values are not a case here.
fn decimal(int value) -> string {
    if (value == 0) {
        return "0";
    }
    string result = "";
    while (value > 0) {
        int digit = value % 10;
        result = substring("0123456789", digit, digit + 1) + result;
        value = value / 10;
    }
    return result;
}

// new_function allocates an empty function whose binding table starts with
// spare space and which defines zero labels.
public fn new_function(string name, NativeType result) -> NativeFunction {
    return NativeFunction {
        name = name,
        result = result,
        parameter_types = new NativeType[0],
        parameter_count = 0,
        binding_types = new NativeType[16],
        binding_count = 0,
        binding_capacity = 16,
        label_count = 0,
        instructions = new Instruction[16],
        instruction_count = 0,
        instruction_capacity = 16
    };
}

// new_scene allocates an empty scene; the caller sets entry after the
// functions exist.
public fn new_scene() -> NativeScene {
    return NativeScene {
        functions = new NativeFunction[8],
        function_count = 0,
        function_capacity = 8,
        blobs = new DataBlob[8],
        blob_count = 0,
        blob_capacity = 8,
        entry = 0
    };
}

// grow_bindings doubles a function's binding table. Functions are struct
// references, so the caller's copy of the function pointer sees the change.
fn grow_bindings(NativeFunction function) {
    int capacity = function.binding_capacity * 2;
    NativeType[] grown = new NativeType[capacity];
    int index = 0;
    while (index < function.binding_count) {
        grown[index] = function.binding_types[index];
        index++;
    }
    function.binding_types = grown;
    function.binding_capacity = capacity;
}

// new_binding appends one binding of the given shape and returns its index.
fn new_binding(NativeFunction function, NativeType shape) -> int {
    if (function.binding_count == function.binding_capacity) {
        grow_bindings(function);
    }
    function.binding_types[function.binding_count] = shape;
    function.binding_count++;
    return function.binding_count - 1;
}

// grow_instructions doubles a function's instruction list.
fn grow_instructions(NativeFunction function) {
    int capacity = function.instruction_capacity * 2;
    Instruction[] grown = new Instruction[capacity];
    int index = 0;
    while (index < function.instruction_count) {
        grown[index] = function.instructions[index];
        index++;
    }
    function.instructions = grown;
    function.instruction_capacity = capacity;
}

// append_instruction adds one instruction in program order; the label count
// updates at the same time so jump and label validation stays index-exact.
// Call instructions carry their argument arrays by reference, so the stored
// instruction holds its own copy: a builder that reuses one argument array
// across several calls must not have a later write reach an instruction
// pushed before it.
fn append_instruction(NativeFunction function, Instruction instruction) {
    if (function.instruction_count == function.instruction_capacity) {
        grow_instructions(function);
    }
    function.instructions[function.instruction_count] = snapshot_arguments(instruction);
    function.instruction_count++;
    match (instruction) {
        Label(ignored) {
            function.label_count++;
        }
        ConstInt(n, v) {}
        ConstBool(n, v) {}
        ConstRefData(n, b) {}
        ConstFloat(n, bits) {}
        Copy(n, s) {}
        Add(n, l, r) {}
        Subtract(n, l, r) {}
        Multiply(n, l, r) {}
        WholeDivide(n, l, r) {}
        WholeRemainder(n, l, r) {}
        AddFloat(n, l, r) {}
        SubtractFloat(n, l, r) {}
        MultiplyFloat(n, l, r) {}
        DivideFloat(n, l, r) {}
        Negate(n, v) {}
        NegateFloat(n, v) {}
        Equal(n, l, r) {}
        LessThan(n, l, r) {}
        EqualFloat(n, l, r) {}
        GreaterFloat(n, l, r) {}
        LessOrEqualFloat(n, l, r) {}
        Call(n, c, a, count) {}
        CallVoid(c, a, count) {}
        RawLoad64(n, a, o) {}
        RawSyscall(n, m, a, count) {}
        GetStatic(n, b, o) {}
        SetStatic(b, o, v) {}
        FailOOM {}
        RawStore64(a, o, v) {}
        FloatBits(n, v) {}
        RawLoad8(n, a, o) {}
        RawStore8(a, o, v) {}
        StackPointer(n) {}
        Jump(l) {}
        Branch(c, t, f) {}
        Return(v) {}
        ReturnVoid {}
    }
}

// snapshot_arguments replaces a pushed instruction with one whose argument
// array is its own copy, so the scene stays an immutable snapshot.
fn snapshot_arguments(Instruction instruction) -> Instruction {
    match (instruction) {
        Call(target, callee, arguments, argument_count) {
            return Instruction.Call { target = target, function = callee, arguments = copy_arguments(arguments, argument_count), argument_count = argument_count };
        }
        CallVoid(callee, arguments, argument_count) {
            return Instruction.CallVoid { function = callee, arguments = copy_arguments(arguments, argument_count), argument_count = argument_count };
        }
        RawSyscall(target, number, arguments, argument_count) {
            return Instruction.RawSyscall { target = target, number = number, arguments = copy_arguments(arguments, argument_count), argument_count = argument_count };
        }
        ConstInt(n, v) { return instruction; }
        ConstBool(n, v) { return instruction; }
        ConstRefData(n, b) { return instruction; }
        ConstFloat(n, bits) { return instruction; }
        Copy(n, s) { return instruction; }
        Add(n, l, r) { return instruction; }
        Subtract(n, l, r) { return instruction; }
        Multiply(n, l, r) { return instruction; }
        WholeDivide(n, l, r) { return instruction; }
        WholeRemainder(n, l, r) { return instruction; }
        AddFloat(n, l, r) { return instruction; }
        SubtractFloat(n, l, r) { return instruction; }
        MultiplyFloat(n, l, r) { return instruction; }
        DivideFloat(n, l, r) { return instruction; }
        Negate(n, v) { return instruction; }
        NegateFloat(n, v) { return instruction; }
        Equal(n, l, r) { return instruction; }
        LessThan(n, l, r) { return instruction; }
        EqualFloat(n, l, r) { return instruction; }
        GreaterFloat(n, l, r) { return instruction; }
        LessOrEqualFloat(n, l, r) { return instruction; }
        RawLoad64(n, a, o) { return instruction; }
        GetStatic(n, b, o) { return instruction; }
        SetStatic(b, o, v) { return instruction; }
        FailOOM { return instruction; }
        RawStore64(a, o, v) { return instruction; }
        RawLoad8(n, a, o) { return instruction; }
        RawStore8(a, o, v) { return instruction; }
        StackPointer(n) { return instruction; }
        FloatBits(n, v) { return instruction; }
        Jump(l) { return instruction; }
        Branch(c, t, f) { return instruction; }
        Label(l) { return instruction; }
        Return(v) { return instruction; }
        ReturnVoid { return instruction; }
    }
}

// copy_arguments duplicates one argument array exactly.
fn copy_arguments(int[] source, int count) -> int[] {
    int[] copy = new int[count];
    int index = 0;
    while (index < count) {
        copy[index] = source[index];
        index++;
    }
    return copy;
}

// push_instruction is the public append; its name documents that callers push
// pre-validated indices and let check_scene be the gate.
public fn push_instruction(NativeFunction function, Instruction instruction) {
    append_instruction(function, instruction);
}

// grow_blobs doubles the scene's blob list; the scene is a struct reference, so
// the caller's copy sees the change.
fn grow_blobs(NativeScene scene) {
    int capacity = scene.blob_capacity * 2;
    DataBlob[] grown = new DataBlob[capacity];
    int index = 0;
    while (index < scene.blob_count) {
        grown[index] = scene.blobs[index];
        index++;
    }
    scene.blobs = grown;
    scene.blob_capacity = capacity;
}

// add_blob appends one static data blob and returns its index.
public fn add_blob(NativeScene scene, string bytes) -> int {
    if (scene.blob_count == scene.blob_capacity) {
        grow_blobs(scene);
    }
    DataBlob blob = DataBlob {
        name = "$blob" + decimal(scene.blob_count),
        bytes = bytes
    };
    scene.blobs[scene.blob_count] = blob;
    scene.blob_count++;
    return scene.blob_count - 1;
}

// new_temporary extends a function's binding table with one local binding and
// returns its index.
public fn new_temporary(NativeFunction function, NativeType shape) -> int {
    return new_binding(function, shape);
}

// grow_functions doubles the scene's function list.
fn grow_functions(NativeScene scene) {
    int capacity = scene.function_capacity * 2;
    NativeFunction[] grown = new NativeFunction[capacity];
    int index = 0;
    while (index < scene.function_count) {
        grown[index] = scene.functions[index];
        index++;
    }
    scene.functions = grown;
    scene.function_capacity = capacity;
}

// add_function appends one empty function, pre-creating its parameter bindings
// in order, and returns the function index. The caller then fills the body
// through the function reference.
public fn add_function(NativeScene scene, string name, NativeType result, NativeType[] parameter_types, int parameter_count) -> int {
    if (scene.function_count == scene.function_capacity) {
        grow_functions(scene);
    }
    NativeFunction function = new_function(name, result);
    int index = 0;
    while (index < parameter_count) {
        new_binding(function, parameter_types[index]);
        index++;
    }
    function.parameter_types = parameter_types;
    function.parameter_count = parameter_count;
    scene.functions[scene.function_count] = function;
    scene.function_count++;
    return scene.function_count - 1;
}

// function_at returns the function reference at one scene index.
public fn function_at(NativeScene scene, int index) -> NativeFunction {
    return scene.functions[index];
}

// require_binding checks that an index is in range and, when expected carries a
// shape, that the binding carries exactly that shape. Passing Void for expected
// checks the range alone; call sites use this to accept any-shape operands.
// On failure it returns the full deterministic message, and "" on success.
fn require_binding(NativeFunction function, int index, NativeType expected, string context) -> string {
    if (index < 0 || index >= function.binding_count) {
        return context + " binding " + decimal(index) + " is out of range (the function has " + decimal(function.binding_count) + " bindings)";
    }
    if (type_size(expected) != 0) {
        NativeType actual = function.binding_types[index];
        if (type_name(actual) != type_name(expected)) {
            return context + " binding " + decimal(index) + " has " + type_name(actual) + ", expected " + type_name(expected);
        }
    }
    return "";
}

// require_label checks one label index against the function's label count.
fn require_label(NativeFunction function, int label, string context) -> string {
    if (label < 0 || label >= function.label_count) {
        return context + "label " + decimal(label) + " is out of range (the function defines " + decimal(function.label_count) + " labels)";
    }
    return "";
}

// check_scene validates the whole scene at once: result and binding shapes,
// instruction index ranges and shapes, label definitions and references, call
// agreement, and the entry index. It is the native backend's first gate, and
// the layout pass, the selector, and the ELF writer may rely on a scene that
// passed it.
public fn check_scene(NativeScene scene) -> SceneResult {
    if (scene.entry < 0 || scene.entry >= scene.function_count) {
        return SceneResult.Failed {
            message = "entry " + decimal(scene.entry) + " is out of range (the scene has " + decimal(scene.function_count) + " functions)"
        };
    }

    int index = 0;
    while (index < scene.function_count) {
        NativeFunction function = function_at(scene, index);
        string failure = check_function(scene, function);
        if (length(failure) != 0) {
            return SceneResult.Failed { message = failure };
        }
        index++;
    }
    return SceneResult.Ok;
}

// check_function validates one function: every parameter and binding carries a
// real shape, every label reference has a definition, and every instruction is
// well-formed against the binding table.
fn check_function(NativeScene scene, NativeFunction function) -> string {
    string context = "function @" + function.name + ": ";
    string start = context + "the function has ";

    int parameter = 0;
    while (parameter < function.parameter_count) {
        if (type_size(function.parameter_types[parameter]) == 0) {
            return start + "no shape for parameter " + decimal(parameter);
        }
        parameter++;
    }

    int binding = 0;
    while (binding < function.binding_count) {
        if (type_size(function.binding_types[binding]) == 0) {
            return start + "no shape for binding " + decimal(binding);
        }
        binding++;
    }

    int label = 0;
    while (label < function.label_count) {
        if (!label_defined(function, label)) {
            return context + "label " + decimal(label) + " is referenced but never defined";
        }
        label++;
    }

    int instruction_index = 0;
    while (instruction_index < function.instruction_count) {
        string failure = check_instruction(scene, function, instruction_index);
        if (length(failure) != 0) {
            return failure;
        }
        instruction_index++;
    }
    return "";
}

// check_instruction validates one instruction's index ranges, operand shapes,
// and call agreement, reading the enclosing function's binding table. Every
// failure names the function, the instruction, and the offending role, in that
// order.
fn check_instruction(NativeScene scene, NativeFunction function, int instruction_index) -> string {
    Instruction instruction = function.instructions[instruction_index];
    string position = "function @" + function.name + ": instruction " + decimal(instruction_index) + ": ";
    string failure = "";

    match (instruction) {
        ConstInt(target, value) {
            failure = require_binding(function, target, NativeType.Int, position + "target");
        }
        ConstBool(target, value) {
            failure = require_binding(function, target, NativeType.Bool, position + "target");
        }
        ConstRefData(target, blob) {
            failure = require_binding(function, target, NativeType.Ref, position + "target");
        }
        Copy(target, source) {
            failure = require_binding(function, source, NativeType.Void, position + "source");
            if (length(failure) == 0) {
                NativeType shape = function.binding_types[source];
                string source_name = type_name(shape);
                string target_name = type_name(function.binding_types[target]);
                bool crossable = (source_name == "int" || source_name == "ref") ;
                crossable = crossable && (target_name == "int" || target_name == "ref");
                if (crossable) {
                    // Int and ref are the same 64-bit value on this
                    // machine; the collector's shells hand block addresses
                    // to the language across exactly this boundary. Bool
                    // and float shapes stay strict.
                    failure = "";
                } else {
                    failure = require_binding(function, target, shape, position + "target");
                }
            }
        }
        ConstFloat(target, bits) {
            failure = require_binding(function, target, NativeType.Float, position + "target");
        }
        Add(target, left, right) {
            failure = check_fold(function, target, left, right, position);
        }
        Subtract(target, left, right) {
            failure = check_fold(function, target, left, right, position);
        }
        Multiply(target, left, right) {
            failure = check_int_pair(function, target, left, right, position);
        }
        WholeDivide(target, left, right) {
            failure = check_int_pair(function, target, left, right, position);
        }
        WholeRemainder(target, left, right) {
            failure = check_int_pair(function, target, left, right, position);
        }
        AddFloat(target, left, right) {
            failure = check_float_pair(function, target, left, right, position);
        }
        SubtractFloat(target, left, right) {
            failure = check_float_pair(function, target, left, right, position);
        }
        MultiplyFloat(target, left, right) {
            failure = check_float_pair(function, target, left, right, position);
        }
        DivideFloat(target, left, right) {
            failure = check_float_pair(function, target, left, right, position);
        }
        Negate(target, value) {
            failure = require_binding(function, value, NativeType.Int, position + "operand");
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Int, position + "target");
            }
        }
        NegateFloat(target, value) {
            failure = require_binding(function, value, NativeType.Float, position + "operand");
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Float, position + "target");
            }
        }
        Equal(target, left, right) {
            failure = check_compare(function, target, left, right, position);
        }
        LessThan(target, left, right) {
            failure = check_compare(function, target, left, right, position);
        }
        EqualFloat(target, left, right) {
            failure = check_float_compare(function, target, left, right, position);
        }
        GreaterFloat(target, left, right) {
            failure = check_float_compare(function, target, left, right, position);
        }
        LessOrEqualFloat(target, left, right) {
            failure = check_float_compare(function, target, left, right, position);
        }
        Call(target, callee, arguments, argument_count) {
            failure = check_call(scene, function, callee, arguments, argument_count, position, true);
            if (length(failure) == 0) {
                NativeFunction target_function = function_at(scene, callee);
                failure = require_binding(function, target, target_function.result, position + "target");
            }
        }
        CallVoid(callee, arguments, argument_count) {
            failure = check_call(scene, function, callee, arguments, argument_count, position, false);
        }
        RawLoad64(target, address, offset) {
            failure = require_binding(function, address, NativeType.Void, position + "address");
            if (length(failure) == 0) {
                NativeType address_shape = function.binding_types[address];
                if (type_size(address_shape) == 0) {
                    failure = position + "address binding " + decimal(address) + " has no shape";
                }
            }
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Void, position + "target");
                if (length(failure) == 0) {
                    NativeType target_shape = function.binding_types[target];
                    if (type_size(target_shape) == 0) {
                        failure = position + "target binding " + decimal(target) + " has no shape";
                    } else if (type_name(target_shape) == type_name(NativeType.Bool) || type_name(target_shape) == type_name(NativeType.Void)) {
                        failure = position + "target binding " + decimal(target) + " carries " + type_name(target_shape) + ", which cannot hold a raw 8-byte slot";
                    }
                }
            }
            if (length(failure) == 0 && (offset < 0 || offset > 255)) {
                failure = position + "offset " + decimal(offset) + " is outside the selector's constant-offset range 0..255";
            }
        }
        GetStatic(target, blob, offset) {
            failure = check_static_slot(scene, blob, offset, position);
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Int, position + "target");
            }
        }
        SetStatic(blob, offset, value) {
            failure = check_static_slot(scene, blob, offset, position);
            if (length(failure) == 0) {
                failure = require_binding(function, value, NativeType.Int, position + "value");
            }
        }
        FailOOM {
            failure = "";
        }
        RawStore64(address, offset, value) {
            failure = check_raw_address(function, address, position + "address");
            if (length(failure) == 0) {
                failure = require_binding(function, value, NativeType.Int, position + "value");
            }
            if (length(failure) == 0 && (offset < 0 || offset > 255)) {
                failure = position + "offset " + decimal(offset) + " is outside the selector's constant-offset range 0..255";
            }
        }
        RawLoad8(target, address, offset) {
            failure = check_raw_address(function, address, position + "address");
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Int, position + "target");
            }
            if (length(failure) == 0 && (offset < 0 || offset > 255)) {
                failure = position + "offset " + decimal(offset) + " is outside the selector's constant-offset range 0..255";
            }
        }
        RawStore8(address, offset, value) {
            failure = check_raw_address(function, address, position + "address");
            if (length(failure) == 0) {
                failure = require_binding(function, value, NativeType.Int, position + "value");
            }
            if (length(failure) == 0 && (offset < 0 || offset > 255)) {
                failure = position + "offset " + decimal(offset) + " is outside the selector's constant-offset range 0..255";
            }
        }
        StackPointer(target) {
            failure = require_binding(function, target, NativeType.Int, position + "target");
        }
        FloatBits(target, value) {
            failure = require_binding(function, value, NativeType.Float, position + "value");
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Int, position + "target");
            }
        }
        RawSyscall(target, number, arguments, argument_count) {
            failure = require_binding(function, number, NativeType.Int, position + "number");
            if (length(failure) == 0) {
                failure = require_binding(function, target, NativeType.Int, position + "target");
            }
            if (length(failure) == 0 && argument_count > 6) {
                failure = position + "a syscall passes at most six arguments, got " + decimal(argument_count);
            }
            if (length(failure) == 0) {
                int index = 0;
                while (index < argument_count && length(failure) == 0) {
                    failure = require_binding(function, arguments[index], NativeType.Void, position + "argument " + decimal(index));
                    if (length(failure) == 0) {
                        NativeType shape = function.binding_types[arguments[index]];
                        if (type_size(shape) != 8) {
                            failure = position + "argument " + decimal(index) + " binding " + decimal(arguments[index]) + " carries " + type_name(shape) + ", which is not an 8-byte register value";
                        }
                    }
                    index++;
                }
            }
        }
        Jump(label) {
            failure = require_label(function, label, position);
        }
        Branch(condition, label_true, label_false) {
            failure = require_binding(function, condition, NativeType.Bool, position + "condition");
            if (length(failure) == 0) {
                failure = require_label(function, label_true, position + "true ");
                if (length(failure) == 0) {
                    failure = require_label(function, label_false, position + "false ");
                }
            }
        }
        Label(label) {
            failure = require_label(function, label, position);
        }
        Return(value) {
            failure = require_binding(function, value, function.result, position + "result");
            if (length(failure) == 0 && type_size(function.result) == 0) {
                failure = position + "a void function must use ReturnVoid";
            }
        }
        ReturnVoid {
            if (type_size(function.result) != 0) {
                failure = position + "a function returning " + type_name(function.result) + " must use Return";
            }
        }
    }
    return failure;
}

// check_int_pair is the integer binary-operation gate: both operands and the
// target carry int shapes.
fn check_int_pair(NativeFunction function, int target, int left, int right, string position) -> string {
    string failure = require_binding(function, left, NativeType.Int, position + "left");
    if (length(failure) != 0) {
        return failure;
    }
    failure = require_binding(function, right, NativeType.Int, position + "right");
    if (length(failure) != 0) {
        return failure;
    }
    return require_binding(function, target, NativeType.Int, position + "target");
}

// check_raw_address is the common gate for the raw-address forms: the
// address binding must carry any real shape, since ints and refs are the
// same 64-bit value on the machine.
fn check_raw_address(NativeFunction function, int index, string role) -> string {
    string failure = require_binding(function, index, NativeType.Void, role);
    if (length(failure) == 0 && type_size(function.binding_types[index]) == 0) {
        return role + " binding " + decimal(index) + " has no shape";
    }
    return "";
}

// check_fold is the Add/Subtract gate: both operands carry int or ref (a
// reference folds with byte offsets, which is how the runtime reaches
// object fields and payload bytes), and the target carries int. Every
// arithmetic-only form keeps the stricter check_int_pair.
fn check_fold(NativeFunction function, int target, int left, int right, string position) -> string {
    string failure = check_raw_address(function, left, position + "left");
    if (length(failure) != 0) {
        return failure;
    }
    failure = check_raw_address(function, right, position + "right");
    if (length(failure) != 0) {
        return failure;
    }
    return require_binding(function, target, NativeType.Int, position + "target");
}

// check_float_pair is the float binary-operation gate: both operands and the
// target carry float shapes.
fn check_float_pair(NativeFunction function, int target, int left, int right, string position) -> string {
    string failure = require_binding(function, left, NativeType.Float, position + "left");
    if (length(failure) != 0) {
        return failure;
    }
    failure = require_binding(function, right, NativeType.Float, position + "right");
    if (length(failure) != 0) {
        return failure;
    }
    return require_binding(function, target, NativeType.Float, position + "target");
}

// check_compare is the integer comparison gate: both operands carry int shapes
// and the target carries bool.
fn check_compare(NativeFunction function, int target, int left, int right, string position) -> string {
    string failure = require_binding(function, left, NativeType.Int, position + "left");
    if (length(failure) != 0) {
        return failure;
    }
    failure = require_binding(function, right, NativeType.Int, position + "right");
    if (length(failure) != 0) {
        return failure;
    }
    return require_binding(function, target, NativeType.Bool, position + "target");
}

// check_float_compare is the float comparison gate: both operands carry
// float shapes and the target carries bool. The three forms cover every
// ordered comparison the lowering derives; unordered values make all three
// false, exactly as the C pipeline's generated comparisons do.
fn check_float_compare(NativeFunction function, int target, int left, int right, string position) -> string {
    string failure = require_binding(function, left, NativeType.Float, position + "left");
    if (length(failure) != 0) {
        return failure;
    }
    failure = require_binding(function, right, NativeType.Float, position + "right");
    if (length(failure) != 0) {
        return failure;
    }
    return require_binding(function, target, NativeType.Bool, position + "target");
}

// check_call validates one call against its callee: an in-range function
// index, the exact argument count, shape agreement between the caller's
// argument bindings and the callee's parameters, and, through result_expected,
// the call kind's agreement with the callee's result.
fn check_call(NativeScene scene, NativeFunction caller, int callee, int[] arguments, int argument_count, string position, bool result_expected) -> string {
    if (callee < 0 || callee >= scene.function_count) {
        return position + "function " + decimal(callee) + " is out of range (the scene has " + decimal(scene.function_count) + " functions)";
    }
    NativeFunction target = function_at(scene, callee);
    if (argument_count != target.parameter_count) {
        return position + "the call passes " + decimal(argument_count) + " arguments, but @" + target.name + " takes " + decimal(target.parameter_count);
    }
    int index = 0;
    while (index < argument_count) {
        string argument_failure = require_binding(caller, arguments[index], target.parameter_types[index], position + "argument " + decimal(index));
        if (length(argument_failure) != 0) {
            return argument_failure;
        }
        index++;
    }
    bool target_void = type_size(target.result) == 0;
    if (target_void == result_expected) {
        return position + "@" + target.name + " returns " + type_name(target.result) + ", which does not match this kind of call";
    }
    return "";
}

// check_static_slot is the GetStatic/SetStatic gate: the blob index and the
// raw offset must name eight bytes inside the blob's whole mapped size, which
// blob_total fixes and the selector's layout fills. SetStatic checks its
// value shape through require_binding after the slot itself checks.
fn check_static_slot(NativeScene scene, int blob, int offset, string position) -> string {
    if (blob < 0 || blob >= scene.blob_count) {
        return position + "blob " + decimal(blob) + " is out of range (the scene has " + decimal(scene.blob_count) + " blobs)";
    }
    int total = blob_total(scene, blob);
    if (offset < 0 || offset + 8 > total) {
        return position + "offset " + decimal(offset) + " does not fit blob $blob" + decimal(blob) + "'s " + decimal(total) + " bytes";
    }
    return "";
}

// label_defined reports whether a Label instruction defines the label.
fn label_defined(NativeFunction function, int label) -> bool {
    int index = 0;
    while (index < function.instruction_count) {
        match (function.instructions[index]) {
            Label(defined_label) {
                if (defined_label == label) {
                    return true;
                }
            }
            ConstInt(n, v) {}
            ConstBool(n, v) {}
            ConstRefData(n, b) {}
            ConstFloat(n, bits) {}
            Copy(n, s) {}
            Add(n, l, r) {}
            Subtract(n, l, r) {}
            Multiply(n, l, r) {}
            WholeDivide(n, l, r) {}
            WholeRemainder(n, l, r) {}
            AddFloat(n, l, r) {}
            SubtractFloat(n, l, r) {}
            MultiplyFloat(n, l, r) {}
            DivideFloat(n, l, r) {}
            Negate(n, v) {}
            NegateFloat(n, v) {}
            Equal(n, l, r) {}
            LessThan(n, l, r) {}
            EqualFloat(n, l, r) {}
            GreaterFloat(n, l, r) {}
            LessOrEqualFloat(n, l, r) {}
            Call(n, c, a, count) {}
            CallVoid(c, a, count) {}
            RawLoad64(n, a, o) {}
            RawSyscall(n, m, a, count) {}
            GetStatic(n, b, o) {}
            SetStatic(b, o, v) {}
            FailOOM {}
            RawStore64(a, o, v) {}
            RawLoad8(n, a, o) {}
            RawStore8(a, o, v) {}
            StackPointer(n) {}
            FloatBits(n, v) {}
            Jump(l) {}
            Branch(c, t, f) {}
            Return(v) {}
            ReturnVoid {}
        }
        index++;
    }
    return false;
}
