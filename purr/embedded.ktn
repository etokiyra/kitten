        "rray->length);\n        ktn_rt_fail(message);\n    }\n    return (char *)array->data" +
        " + (size_t)index * (size_t)array->element_size;\n}\n\nint64_t ktn_rt_array_length(co" +
        "nst ktn_array *array) {\n    if (array == NULL) {\n        ktn_rt_fail(\"length of a" +
        " null array reference\");\n    }\n    return array->length;\n}\n\nktn_array *ktn_rt_" +
        "string_to_bytes(const ktn_string *value) {\n    const ktn_string *checked = ktn_rt_s" +
        "tring_value(value);\n    ktn_array *result = ktn_rt_array_new(checked->length, (int6" +
        "4_t)sizeof(uint8_t));\n    memcpy(result->data, checked->data, (size_t)checked->leng" +
        "th);\n    return result;\n}\n\nconst ktn_string *ktn_rt_bytes_to_string(const ktn_ar" +
        "ray *bytes) {\n    if (bytes == NULL) {\n        ktn_rt_fail(\"byte array is null\")" +
        ";\n    }\n    if (bytes->element_size != (int64_t)sizeof(uint8_t)) {\n        ktn_rt" +
        "_fail(\"byte array element size is not 1\");\n    }\n\n    const uint8_t *data = (co" +
        "nst uint8_t *)bytes->data;\n    for (int64_t index = 0; index < bytes->length; index" +
        "++) {\n        if (data[index] == 0) {\n            char message[160];\n            " +
        "snprintf(message, sizeof(message), \"byte array contains a NUL byte at index %lld\"," +
        " (long long)index);\n            ktn_rt_fail(message);\n        }\n    }\n\n    ktn_" +
        "string *result = ktn_rt_string_allocate(bytes->length);\n    memcpy(ktn_rt_string_by" +
        "tes(result), data, (size_t)bytes->length);\n    return result;\n}\n\n/*\n * The proc" +
        "ess argument vector saved by ktn_rt_set_args. It is initialized to an\n * empty vect" +
        "or so that ktn_rt_argv is safe before the generated entry point has\n * run, althoug" +
        "h generated programs always set it before user code.\n */\nstatic int ktn_rt_saved_a" +
        "rgc = 0;\nstatic char **ktn_rt_saved_argv = NULL;\n\nvoid ktn_rt_set_args(int argc, " +
