        "age);\n\n/*\n * Executes program directly with execve semantics, using args as argv[" +
        "1..]\n * and program as argv[0]. The child inherits the environment, working\n * dir" +
        "ectory, and descriptors 0, 1, and 2. On success the child's exit status is\n * store" +
        "d in *status (128 + signal for a signal termination) and *message is\n * NULL. A fai" +
        "lure to start the program stores a Go-compatible\n * \"fork/exec <program>: <reason>" +
        "\" message and returns false; a nonzero child\n * status is still success. Both outp" +
        "ut streams are flushed before forking.\n */\nbool ktn_rt_try_run(const ktn_strin" +
        "";
}

fn embedded_runtime_header_chunk_5() -> string {
    return "g *program,\n                    const ktn_array *args,\n                    int64_t" +
        " *status,\n                    const ktn_string **message);\n\n/*\n * Returns the pr" +
        "ocess's absolute current working directory as a fresh\n * GC-managed string. It uses" +
        " getcwd, ignores PWD, and grows the buffer on\n * ERANGE. On failure it stores a Go-" +
        "compatible \"getwd: <reason>\" message and\n * returns false.\n */\nbool ktn_rt_try_" +
        "current_directory(const ktn_string **path,\n                                  const " +
        "ktn_string **message);\n\n/*\n * Reads one environment variable. Returns true and st" +
        "ores a fresh GC-managed\n * copy of its value when the variable exists, including wh" +
        "en the value is the\n * empty string. Returns false when the variable is unset, the " +
        "name is empty, or\n * the name contains '='. PWD is an ordinary variable here; no li" +
        "bc ordering or\n * shell expansion is involved.\n */\nbool ktn_rt_try_getenv(const k" +
        "tn_string *name, const ktn_string **value);\n\n/*\n * Runs program with try_run's di" +
        "rect-exec semantics while putting stdin on\n * /dev/null and capturing stdout and st" +
        "derr separately. Each stream is capped\n * at 16777216 bytes; exceeding the cap kill" +
        "s and reaps the child and fails with\n * \"run <program>: <stream> exceeds the 16777" +
        "216 byte limit\". A NUL byte in a\n * captured stream fails after reaping with\n * " +
        "\"run <program>: <stream> contains a NUL byte at offset <n>\".\n */\nbool ktn_rt_try" +
        "_run_capture(const ktn_string *program,\n                            const ktn_array" +
        " *args,\n                            int64_t *status,\n                            c" +
        "onst ktn_string **out,\n                            const ktn_string **err,\n       " +
        "                     const ktn_string **message);\n\n/* Result codes for ktn_rt_try_" +
        "file_info. */\n#define KTN_RT_FILE_INFO_OK 0\n#define KTN_RT_FILE_INFO_MISSING 1\n#d" +
        "efine KTN_RT_FILE_INFO_FAILED 2\n\n/*\n * Reports file metadata without opening a fi" +
        "le descriptor. lstat classifies the\n * path itself; a symlink is followed by stat f" +
        "or is_file/is_directory/size, and\n * access(X_OK) supplies executable. ENOENT/ENOTD" +
        "IR from lstat is Missing; a\n * dangling link is Ok with only is_symlink set. Other " +
        "failures use lstat/stat\n * path text. Sizes above INT64_MAX cannot occur.\n */\nint" +
        " ktn_rt_try_file_info(const ktn_string *path,\n                         bool *is_fil" +
        "e,\n                         bool *is_directory,\n                         bool *is_" +
        "symlink,\n                         bool *executable,\n                         int64" +
        "_t *size,\n                         const ktn_string **message);\n\n/*\n * Creates a" +
        "n absolute, unique temporary directory. The base is a non-empty\n * $TMPDIR (made ab" +
        "solute against getcwd when relative) or /tmp; an unusable\n * base fails instead of " +
        "falling back. The prefix must be 1..64 ASCII bytes from\n * [A-Za-z0-9._-], and may " +
        "not be \"..\", or the call fails with\n * \"invalid temporary directory prefix\" bef" +
        "ore filesystem access. mkdtemp\n * supplies the atomic six-character suffix and mode" +
        " 0700. Returns true and a\n * fresh GC-managed path, or false and a Go-compatible mk" +
        "dir/stat message.\n * Opens no file descriptor and registers no cleanup hook.\n */\n" +
        "bool ktn_rt_try_create_temp_directory(const ktn_string *prefix,\n                   " +
        "                   const ktn_string **path,\n                                      c" +
        "onst ktn_string **message);\n\n/*\n * Built-in print helpers. Each writes a single v" +
        "alue. Callers separate\n * arguments with single spaces and terminate the line with" +
        "\n * ktn_rt_print_newline.\n */\nvoid ktn_rt_print_int(int64_t value);\nvoid ktn_rt_" +
        "print_float(double value);\nvoid ktn_rt_print_bool(bool value);\nvoid ktn_rt_print_s" +
        "tring(const ktn_string *value);\nvoid ktn_rt_print_space(void);\nvoid ktn_rt_print_n" +
        "ewline(void);\n\n/*\n * Built-in eprint helpers. Each writes a single value to stand" +
