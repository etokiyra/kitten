        "LIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FO" +
        "R A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COP" +
        "YRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN A" +
        "N ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n * FROM, OUT OF OR IN CONNECTION W" +
        "ITH THE SOFTWARE OR THE USE OR OTHER DEALINGS\n * IN THE SOFTWARE.\n */\n#define _PO" +
        "SIX_C_SOURCE 200809L\n\n#include \"kitten_runtime.h\"\n\nextern char **environ;\n\n#" +
        "include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <poll.h>\n#incl" +
        "ude <signal.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#inclu" +
        "de <sys/stat.h>\n#include <sys/wait.h>\n#include <unistd.h>\n\n/*\n * Flushes both o" +
        "utput streams in the order a process exit must preserve: stdout\n * first, then stde" +
        "rr. Every terminating path shares this sequence.\n */\nstatic void ktn_rt_flush_stre" +
        "ams(void) {\n    fflush(stdout);\n    fflush(stderr);\n}\n\n/*\n * Reports an unreco" +
        "verable runtime error to standard error and terminates the\n * program. Used for con" +
        "ditions that cannot be recovered from, such as an\n * out-of-range array index, an a" +
        "llocation that would overflow, or inspecting a\n * null union reference.\n */\nvoid " +
        "ktn_rt_fail(const char *message) {\n    ktn_rt_flush_streams();\n    fputs(\"purr: " +
        "\", stderr);\n    fputs(message, stderr);\n    fputc('\\n', stderr);\n    ktn_rt_exi" +
        "t(1);\n}\n\nvoid ktn_rt_exit(int64_t status) {\n    ktn_rt_flush_streams();\n    exi" +
        "t((int)status);\n}\n\n/*\n * Reports an unrecoverable error that concerns a path, in" +
        "cluding the operating\n * system message for a saved errno value.\n */\nstatic void " +
        "ktn_rt_fail_path(const char *action, const ktn_string *path, int error) {\n    char " +
        "message[1024];\n    snprintf(message, sizeof(message), \"%s '%s': %s\", action, path" +
        "->data, strerror(error));\n    ktn_rt_fail(message);\n}\n\nvoid ktn_rt_init(void) {" +
        "\n    GC_INIT();\n}\n\nvoid *ktn_rt_alloc(size_t size) {\n    return GC_MALLOC(size)" +
        ";\n}\n\n/*\n * The static empty string. The zero value of a string is a null pointer" +
        ", so\n * normalization maps every null string to this object, whose data is the stat" +
        "ic\n * empty C string. This makes unassigned string array elements and struct fields" +
        "\n * safe to read.\n */\nstatic const ktn_string ktn_rt_empty_string = { 0, \"\" };" +
        "\n\n/*\n * Returns value, or the static empty string when value is null.\n *\n * Eve" +
        "ry runtime function that reads a string normalizes first, so no caller has\n * to ch" +
        "eck for a null reference and no function has to read through a null\n * pointer.\n *" +
        "/\nstatic const ktn_string *ktn_rt_string_value(const ktn_string *value) {\n    retu" +
        "rn value == NULL ? &ktn_rt_empty_string : value;\n}\n\n/*\n * Allocates a new string" +
        " of exactly length bytes and returns it.\n *\n * The header is fully initialized: le" +
        "ngth is set, data points at the length\n * bytes that immediately follow it, and a N" +
        "UL terminator is written one past\n * them, so the value is always a valid C string " +
        "even while it is being filled.\n " +
        "";
}

fn embedded_runtime_source_chunk_1() -> string {
    return "* The collector zeroes the allocation, so the bytes are a defined all-zero\n * seque" +
        "nce rather than indeterminate storage, and the bytes are written by the\n * caller t" +
        "hrough ktn_rt_string_bytes before the string becomes observable.\n */\nstatic ktn_st" +
        "ring *ktn_rt_string_allocate(int64_t length) {\n    if (length < 0) {\n        ktn_r" +
        "t_fail(\"string length cannot be negative\");\n    }\n    if ((uint64_t)length > (ui" +
        "nt64_t)SIZE_MAX - sizeof(ktn_string) - 1) {\n        ktn_rt_fail(\"string is too lar" +
        "ge\");\n    }\n\n    ktn_string *result = (ktn_string *)ktn_rt_alloc(sizeof(ktn_stri" +
        "ng) + (size_t)length + 1);\n    result->length = length;\n    char *bytes = (char *)" +
        "(result + 1);\n    bytes[length] = '\\0';\n    result->data = bytes;\n    return res" +
        "ult;\n}\n\n/*\n * Returns the bytes of a string that was just allocated, for filling" +
