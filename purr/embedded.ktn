fn embedded_runtime_source_chunk_3() -> string {
    return "d(const ktn_map *map, const ktn_string *key, uint64_t hash) {\n    if (map->capacity" +
        " == 0) {\n        return -1;\n    }\n    size_t mask = (size_t)map->capacity - 1;\n " +
        "   size_t index = (size_t)hash & mask;\n    for (int64_t probes = 0; probes < map->c" +
        "apacity; probes++) {\n        const ktn_string *existing = map->keys[index];\n      " +
        "  if (existing == NULL) {\n            return -1;\n        }\n        if (map->hashe" +
        "s[index] == hash && ktn_rt_string_equal(existing, key)) {\n            return (int64" +
        "_t)index;\n        }\n        index = (index + 1) & mask;\n    }\n    return -1;\n}" +
        "\n\n/* Stores key and a copy of the value's bytes into the first empty slot. */\nsta" +
        "tic void ktn_rt_map_place(ktn_map *map, const ktn_string *key, uint64_t hash, const " +
        "void *value) {\n    size_t mask = (size_t)map->capacity - 1;\n    size_t index = (si" +
        "ze_t)hash & mask;\n    for (int64_t probes = 0; probes < map->capacity; probes++) {" +
        "\n        if (map->keys[index] == NULL) {\n            map->keys[index] = key;\n    " +
        "        map->hashes[index] = hash;\n            memcpy((char *)map->values + index *" +
        " (size_t)map->value_size, value, (size_t)map->value_size);\n            map->length+" +
        "+;\n            return;\n        }\n        index = (index + 1) & mask;\n    }\n    " +
        "ktn_rt_fail(\"map is full\");\n}\n\n/*\n * Grows the table when inserting one more e" +
        "ntry would exceed a 3/4 load factor.\n * All existing entries are rehashed into the " +
        "new table, so no entry is lost.\n */\nstatic void ktn_rt_map_reserve(ktn_map *map) {" +
        "\n    if (map->capacity != 0 && (map->length + 1) * 4 <= map->capacity * 3) {\n     " +
        "   return;\n    }\n    if (map->capacity > INT64_MAX / 2) {\n        ktn_rt_fail(\"m" +
        "ap is too large\");\n    }\n    int64_t capacity = map->capacity == 0 ? 8 : map->cap" +
        "acity * 2;\n\n    if ((uint64_t)capacity > (uint64_t)SIZE_MAX / sizeof(const ktn_str" +
        "ing *) ||\n        (uint64_t)capacity > (uint64_t)SIZE_MAX / sizeof(uint64_t) ||\n  " +
