fn embedded_runtime_source_chunk_2() -> string {
    return "tn_array));\n    array->length = length;\n    array->element_size = element_size;\n" +
        "\n    size_t bytes = (size_t)length * (size_t)element_size;\n    if (bytes == 0) {\n" +
