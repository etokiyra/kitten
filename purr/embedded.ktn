        "char *)value->data;\n}\n\nbool ktn_rt_string_equal(const ktn_string *left, const ktn" +
        "_string *right) {\n    left = ktn_rt_string_value(left);\n    right = ktn_rt_string_" +
        "value(right);\n\n    if (left->length != right->length) {\n        return false;\n  " +
        "  }\n    if (left->length == 0) {\n        return true;\n    }\n    return memcmp(le" +
        "ft->data, right->data, (size_t)left->length) == 0;\n}\n\nconst ktn_string *ktn_rt_st" +
        "ring_concat(const ktn_string *left, const ktn_string *right) {\n    left = ktn_rt_st" +
        "ring_value(left);\n    right = ktn_rt_string_value(right);\n\n    /*\n     * Guard t" +
        "he combined length against overflow. Two strings this large cannot\n     * both exis" +
