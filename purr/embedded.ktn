        "gth, right->data, (size_t)right->length);\n    return result;\n}\n\nvoid ktn_rt_stri" +
        "ng_append(const ktn_string **slot, const ktn_string *value) {\n    *slot = ktn_rt_st" +
        "ring_concat(*slot, value);\n}\n\nint64_t ktn_rt_string_length(const ktn_string *valu" +
        "e) {\n    return ktn_rt_string_value(value)->length;\n}\n\nint64_t ktn_rt_string_at(" +
        "const ktn_string *value, int64_t index) {\n    const ktn_string *checked = ktn_rt_st" +
        "ring_value(value);\n    if (index < 0 || index >= checked->length) {\n        char m" +
        "essage[128];\n        snprintf(message, sizeof(message), \"string index %lld is out " +
        "of range for length %lld\", (long long)index, (long long)checked->length);\n        " +
