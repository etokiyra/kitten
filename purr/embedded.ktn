        "\n    const ktn_string **slots = (const ktn_string **)result->data;\n    int index =" +
        " 0;\n    while (index < count) {\n        const char *text = \"\";\n        if (ktn_" +
        "rt_saved_argv != NULL && ktn_rt_saved_argv[index] != NULL) {\n            text = ktn" +
        "_rt_saved_argv[index];\n        }\n        size_t length = strlen(text);\n        kt" +
        "n_string *value = ktn_rt_string_allocate((int64_t)length);\n        memcpy(ktn_rt_st" +
        "ring_bytes(value), text, length);\n        slots[index] = value;\n        index++;\n" +
        "    }\n    return result;\n}\n\n/*\n * FNV-1a hash of a string, computed over its by" +
