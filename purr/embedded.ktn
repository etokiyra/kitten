        "separate\n * arguments with ktn_rt_eprint_space and terminate the line with\n * ktn_" +
        "rt_eprint_newline. The newline helper flushes standard output before\n * writing the" +
        " newline, so earlier print output appears first on a shared\n * terminal, and then" +
        "";
}

fn embedded_runtime_header_chunk_6() -> string {
    return " flushes standard error.\n */\nvoid ktn_rt_eprint_int(int64_t value);\nvoid ktn_rt_e" +
