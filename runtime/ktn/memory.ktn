// zero_bytes fills count bytes of data with zero using the raw_zero intrinsic.
public fn zero_bytes(byte[] data, int count) {
    raw_zero(address_of(data), count);
}

// copy_bytes returns a fresh byte array holding a copy of data.
public fn copy_bytes(byte[] data) -> byte[] {
    byte[] result = new byte[length(data)];
    raw_copy(address_of(result), address_of(data), length(data));
    return result;
}

// copy_into copies count bytes between arrays; the runtime uses memmove, so
// overlapping arrays are allowed.
public fn copy_into(byte[] destination, byte[] source, int count) {
    raw_copy(address_of(destination), address_of(source), count);
}
