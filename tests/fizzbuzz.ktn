fn main() {
    for (int number = 1; number <= 15; number++) {
        if (number % 15 == 0) {
            print("FizzBuzz");
        } else if (number % 3 == 0) {
            print("Fizz");
        } else if (number % 5 == 0) {
            print("Buzz");
        } else {
            print(number);
        }
    }
}
