# Compiled Go binaries (including the compiler entry point built from cmd/purr).
# The root binary and the purr/ source directory share a name, so the directory
# and its contents are re-included explicitly.
/purr
!/purr/
/purr.exe

# Go build, test, and coverage output.
/bin/
/dist/
/build/
*.test
*.out
*.prof
coverage.txt
vendor/

# Generated compiler output: C source and native object/artifact files.
*.o
*.a
*.obj
*.gcda
*.gcno

# Editor and IDE files.
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system artifacts.
.DS_Store
Thumbs.db
